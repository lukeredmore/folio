# Common Bazel configuration for Folio monorepo (macOS Apple Silicon + Rust + Swift)
build --apple_platform_type=macos
build --macos_minimum_os=26.0
build --host_macos_minimum_os=26.0
build --copt=-Wno-#warnings
build --host_copt=-Wno-#warnings
build --@rules_rust//rust/settings:extra_exec_rustc_flag=-Cstrip=none
build --@rules_rust//rust/settings:extra_rustc_flag=-Cstrip=none
build --incompatible_enable_cc_toolchain_resolution
build --define=apple.experimental.tree_artifact_outputs=1
common --repository_cache=~/.cache/bazel-repo
build --disk_cache=~/.cache/bazel-disk
test --test_output=errors

# Rust lints run as part of every build and test, so `bazel test //...` is the only gate.
# These flags mirror [workspace.lints] in Cargo.toml, which Bazel does not read.
build --aspects=@rules_rust//rust:defs.bzl%rust_clippy_aspect
build --output_groups=+clippy_checks
build --@rules_rust//rust/settings:clippy.toml=//:clippy.toml
build --@rules_rust//rust/settings:rustfmt.toml=//:rustfmt.toml
build --@rules_rust//rust/settings:clippy_flags=-Dwarnings,-Dclippy::allow_attributes,-Dclippy::wildcard_imports,-Wclippy::too_many_lines,-Wclippy::cognitive_complexity,-Wclippy::too_many_arguments,-Wclippy::type_complexity

# CI profile for GitHub Actions macOS Apple Silicon runners
common:ci --color=yes
common:ci --curses=no
common:ci --show_timestamps
common:ci --repository_cache=~/.cache/bazel-repo
build:ci --disk_cache=~/.cache/bazel-disk
build:ci --action_env=CI=true
