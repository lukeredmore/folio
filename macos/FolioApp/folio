#!/usr/bin/env bash
# Folio CLI launcher — opens Markdown files and folders in Folio.app
set -euo pipefail

QUEUE_FILE="${FOLIO_CLI_QUEUE_FILE:-}"
FALLBACK_APP="${FOLIO_FALLBACK_APP:-/Applications/Folio.app}"
CALLER_CWD="${FOLIO_CALLER_CWD:-${BUILD_WORKING_DIRECTORY:-$(pwd -P)}}"
RELEASE_BUNDLE_ID="app.folio.macos"

bundle_identifier() {
    /usr/libexec/PlistBuddy -c "Print :CFBundleIdentifier" "$1/Contents/Info.plist" 2>/dev/null || true
}

# Names the Application Support folder for bundle ID $1.
state_directory_name() {
    if [[ "$1" == "${RELEASE_BUNDLE_ID}" ]]; then echo "Folio"; else echo "Folio-$1"; fi
}

# Prints the PIDs of running Folio processes whose app has bundle ID $1.
running_pids_for_bundle_id() {
    local pid exe
    for pid in $({ pgrep -x Folio; pgrep -x FolioApp; } 2>/dev/null || true); do
        exe="$(ps -p "${pid}" -o comm= 2>/dev/null || true)"
        if [[ "${exe}" != /* ]]; then
            exe="$(/usr/sbin/lsof -a -p "${pid}" -d txt -Fn 2>/dev/null | sed -n 's/^n//p' | grep -m 1 '/Contents/MacOS/' || true)"
        fi
        [[ "${exe}" == */Contents/MacOS/* ]] || continue
        if [[ "$(bundle_identifier "${exe%/Contents/MacOS/*}")" == "$1" ]]; then
            echo "${pid}"
        fi
    done
}

resolve_self_app_bundle() {
    local source="${BASH_SOURCE[0]}"
    while [[ -L "${source}" ]]; do
        local dir
        dir="$(cd -P "$(dirname "${source}")" && pwd)"
        source="$(readlink "${source}")"
        if [[ "${source}" != /* ]]; then source="${dir}/${source}"; fi
    done
    local script_dir
    script_dir="$(cd -P "$(dirname "${source}")" && pwd)"
    local candidate="${script_dir}"
    while [[ "${candidate}" != "/" && "${candidate}" != "." ]]; do
        if [[ "${candidate}" == *.app && -d "${candidate}" ]]; then
            echo "${candidate}"
            return 0
        fi
        candidate="$(dirname "${candidate}")"
    done
    return 1
}

resolve_app_bundle() {
    if [[ -n "${FOLIO_APP_PATH:-}" && -d "${FOLIO_APP_PATH}" ]]; then
        echo "${FOLIO_APP_PATH}"
        return 0
    fi
    local self_bundle
    if self_bundle="$(resolve_self_app_bundle)"; then
        echo "${self_bundle}"
        return 0
    fi
    for candidate in \
        "${RUNFILES_DIR:-}/_main/macos/FolioApp/FolioApp_archive-root/Folio.app" \
        "${0}.runfiles/_main/macos/FolioApp/FolioApp_archive-root/Folio.app" \
        "${BUILD_WORKSPACE_DIRECTORY:-}/Folio.app" \
        "${BUILD_WORKSPACE_DIRECTORY:-}/bazel-bin/macos/FolioApp/FolioApp_archive-root/Folio.app" \
        "/Applications/Folio.app" \
        "$HOME/Applications/Folio.app" \
        "${FALLBACK_APP}"; do
        if [[ -n "${candidate}" && -d "${candidate}" ]]; then
            echo "${candidate}"
            return 0
        fi
    done
    local found
    found="$(mdfind "kMDItemCFBundleIdentifier == '${RELEASE_BUNDLE_ID}'" 2>/dev/null | head -n 1 || true)"
    if [[ -n "${found}" && -d "${found}" ]]; then
        echo "${found}"
        return 0
    fi
    return 1
}

print_help() {
    cat <<'EOF'
Usage: folio [options] [path[:line[:column]] ...]

Open files or folders in Folio.

Options:
  -n, --new          Open in a new Folio instance
  -a, --add          Open in the existing Folio instance
  -w, --wait         Wait for files to be opened
      --foreground   Run Folio in the foreground attached to the terminal
  -v, --version      Print the Folio version and exit
  -h, --help         Print this help message and exit
EOF
}

print_version() {
    local version="1.0.0"
    local app_bundle
    if app_bundle="$(resolve_app_bundle 2>/dev/null)"; then
        local plist="${app_bundle}/Contents/Info.plist"
        if [[ -f "${plist}" ]]; then
            local plist_ver
            plist_ver="$(/usr/libexec/PlistBuddy -c "Print :CFBundleShortVersionString" "${plist}" 2>/dev/null || true)"
            if [[ -n "${plist_ver}" ]]; then
                version="${plist_ver}"
            fi
        fi
    fi
    echo "folio ${version}"
}

FOREGROUND=0
NEW_INSTANCE=0
PARSE_FLAGS=1
RAW_PATHS=()

for arg in "$@"; do
    if (( PARSE_FLAGS == 1 )); then
        case "${arg}" in
            -h|--help)
                print_help
                exit 0
                ;;
            -v|--version)
                print_version
                exit 0
                ;;
            --foreground)
                FOREGROUND=1
                continue
                ;;
            -n|--new)
                NEW_INSTANCE=1
                continue
                ;;
            -a|--add|-e|--existing|-w|--wait)
                continue
                ;;
            --)
                PARSE_FLAGS=0
                continue
                ;;
            -*)
                continue
                ;;
        esac
    fi
    RAW_PATHS+=("${arg}")
done

ABS_PATHS=()
if (( ${#RAW_PATHS[@]} > 0 )); then
    for raw_arg in "${RAW_PATHS[@]}"; do
        cleaned="${raw_arg}"
        if [[ "${cleaned}" == file://* ]]; then
            cleaned="${cleaned#file://}"
        fi
        line_suffix=""
        path_part="${cleaned}"
        if [[ "${path_part}" == "~" ]]; then
            path_part="$HOME"
        elif [[ "${path_part}" == "~/"* ]]; then
            path_part="$HOME/${path_part:2}"
        fi
        if [[ "${path_part}" != /* ]]; then
            path_part="${CALLER_CWD}/${path_part}"
        fi
        if [[ ! -e "${path_part}" ]]; then
            if [[ "${path_part}" =~ ^(.+):([0-9]+:[0-9]+)$ ]]; then
                path_part="${BASH_REMATCH[1]}"
                line_suffix=":${BASH_REMATCH[2]}"
            elif [[ "${path_part}" =~ ^(.+):([0-9]+)$ ]]; then
                path_part="${BASH_REMATCH[1]}"
                line_suffix=":${BASH_REMATCH[2]}"
            fi
        fi
        if [[ -d "${path_part}" ]]; then
            abs_dir="$(cd "${path_part}" && pwd -P)"
            ABS_PATHS+=("${abs_dir}${line_suffix}")
        else
            if [[ ! -e "${path_part}" ]]; then
                mkdir -p "$(dirname "${path_part}")"
                touch "${path_part}"
            fi
            dir_part="$(cd "$(dirname "${path_part}")" && pwd -P)"
            ABS_PATHS+=("${dir_part}/$(basename "${path_part}")${line_suffix}")
        fi
    done
fi

if ! APP_BUNDLE="$(resolve_app_bundle)"; then
    echo "folio: could not locate Folio.app. Move Folio.app to /Applications or set FOLIO_APP_PATH." >&2
    exit 1
fi

if (( FOREGROUND == 1 )); then
    export FOLIO_CALLER_CWD="${CALLER_CWD}"
    APP_EXEC="${APP_BUNDLE}/Contents/MacOS/Folio"
    if [[ ! -x "${APP_EXEC}" && -x "${APP_BUNDLE}/Contents/MacOS/FolioApp" ]]; then
        APP_EXEC="${APP_BUNDLE}/Contents/MacOS/FolioApp"
    fi
    if (( ${#ABS_PATHS[@]} > 0 )); then
        exec "${APP_EXEC}" "${ABS_PATHS[@]}"
    else
        exec "${APP_EXEC}"
    fi
fi

BUNDLE_ID="$(bundle_identifier "${APP_BUNDLE}")"
BUNDLE_ID="${BUNDLE_ID:-${RELEASE_BUNDLE_ID}}"
if [[ -z "${QUEUE_FILE}" ]]; then
    QUEUE_FILE="$HOME/Library/Application Support/$(state_directory_name "${BUNDLE_ID}")/cli_open_requests.txt"
fi

if (( ${#ABS_PATHS[@]} > 0 )); then
    mkdir -p "$(dirname "${QUEUE_FILE}")"
    for p in "${ABS_PATHS[@]}"; do
        printf '%s\n' "${p}" >> "${QUEUE_FILE}"
    done
fi

if (( NEW_INSTANCE == 0 )); then
    RUNNING_PIDS="$(running_pids_for_bundle_id "${BUNDLE_ID}")"
    if [[ -n "${RUNNING_PIDS}" ]]; then
        for pid in ${RUNNING_PIDS}; do
            kill -USR1 "${pid}" 2>/dev/null || true
        done
        osascript -e "tell application \"System Events\" to set frontmost of every process whose bundle identifier is \"${BUNDLE_ID}\" to true" >/dev/null 2>&1 || true
        exit 0
    fi
fi

OPEN_FLAGS=(-a "${APP_BUNDLE}")
if (( NEW_INSTANCE == 1 )); then
    OPEN_FLAGS=(-n -a "${APP_BUNDLE}")
fi
if (( ${#ABS_PATHS[@]} > 0 )); then
    open "${OPEN_FLAGS[@]}" --args "${ABS_PATHS[@]}"
else
    open "${OPEN_FLAGS[@]}"
fi
