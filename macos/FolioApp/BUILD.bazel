load("@build_bazel_rules_apple//apple:macos.bzl", "macos_application")
load("@build_bazel_rules_swift//swift:swift.bzl", "swift_library")
load("//tools/release:defs.bzl", "folio_dmg", "folio_info_plist", "input_hash")

package(default_visibility = ["//visibility:public"])

exports_files([
    "AppIcon.icns",
    "AppIcon-Dev.icns",
    "AppIcon-Zed.icns",
    "Info.plist",
    "folio",
])

filegroup(
    name = "swift_srcs",
    srcs = glob(["*.swift"]),
)

swift_library(
    name = "FolioAppMainLib",
    srcs = ["AppMain.swift"],
    copts = [
        "-swift-version",
        "6",
        "-warnings-as-errors",
    ],
    module_name = "FolioAppMainLib",
    deps = [
        "//:Folio",
    ],
)

# Version, channel, commit and icon keys. --config=release stamps them.
folio_info_plist(
    name = "StampedInfoPlist",
    cargo_toml = "//core/folio_engine:Cargo.toml",
    short_version = "1.0.0",
)

macos_application(
    name = "FolioApp",
    additional_contents = {
        ":folio": "Resources/bin",
    },
    bundle_id = "app.folio.macos",
    bundle_name = "Folio",
    codesignopts = select({
        "//tools/release:adhoc_signing": [],
        "//conditions:default": [
            "--options=runtime",
            "--timestamp",
        ],
    }),
    infoplists = [
        "Info.plist",
        ":StampedInfoPlist",
    ],
    minimum_os_version = "26.0",
    resources = [
        "AppIcon.icns",
        "@swift_math//:math_fonts_bundle",
    ] + select({
        "//tools/release:release_build": [],
        "//conditions:default": ["AppIcon-Dev.icns"],
    }),
    deps = [
        ":FolioAppMainLib",
    ],
)

# Build with --config=release for the stamped, optimized release disk image.
folio_dmg(
    name = "FolioDmg",
    out = "Folio.dmg",
    app = ":FolioApp",
    tags = ["manual"],
    volume_name = "Folio",
)

# CI reuses the latest release DMG when this hash matches the one recorded in that release.
input_hash(
    name = "FolioApp_input_hash",
    extra_srcs = [
        "BUILD.bazel",
        "//:.bazelrc",
        "//:BUILD.bazel",
        "//:Cargo.lock",
        "//:MODULE.bazel",
        "//:MODULE.bazel.lock",
        "//core/folio_engine:BUILD.bazel",
        "//third_party:BUILD.bazel",
        "//third_party:upstream_deps.bzl",
        "//tools/release:BUILD.bazel",
        "//tools/release:defs.bzl",
    ],
    target = ":FolioApp",
)
