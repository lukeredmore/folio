load("@build_bazel_rules_apple//apple:macos.bzl", "macos_application")
load("@build_bazel_rules_swift//swift:swift.bzl", "swift_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "AppIcon.icns",
    "AppIcon-Dev.icns",
    "AppIcon-Zed.icns",
    "Info.plist",
    "folio",
])

swift_library(
    name = "FolioAppMainLib",
    srcs = ["AppMain.swift"],
    copts = [
        "-swift-version",
        "6",
        "-warnings-as-errors",
    ],
    module_name = "FolioAppMainLib",
    deps = [
        "//:Folio",
    ],
)

macos_application(
    name = "FolioApp",
    additional_contents = {
        ":folio": "Resources/bin",
    },
    bundle_id = "app.folio.macos",
    bundle_name = "Folio",
    infoplists = ["Info.plist"],
    minimum_os_version = "26.0",
    resources = [
        "AppIcon.icns",
        "AppIcon-Dev.icns",
        "@swift_math//:math_fonts_bundle",
    ],
    deps = [
        ":FolioAppMainLib",
    ],
)
