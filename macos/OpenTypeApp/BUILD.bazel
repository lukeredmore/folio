load("@build_bazel_rules_apple//apple:macos.bzl", "macos_application")
load("@build_bazel_rules_swift//swift:swift.bzl", "swift_binary", "swift_library")

package(default_visibility = ["//visibility:public"])

swift_library(
    name = "OpenTypeAppMainLib",
    srcs = ["AppMain.swift"],
    module_name = "OpenTypeAppMainLib",
    deps = [
        "//:OpenType",
    ],
)

swift_binary(
    name = "OpenTypeCLI",
    srcs = ["AppMain.swift"],
    deps = [
        "//:OpenType",
    ],
)

macos_application(
    name = "OpenTypeApp",
    bundle_id = "app.opentype.macos",
    bundle_name = "OpenType",
    infoplists = ["Info.plist"],
    minimum_os_version = "14.0",
    deps = [
        ":OpenTypeAppMainLib",
    ],
)

sh_binary(
    name = "OpenTypeLauncher",
    srcs = ["launch_app.sh"],
    data = [
        ":OpenTypeCLI",
        "Info.plist",
    ],
)

