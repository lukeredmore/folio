      "input": "- [x] Ship engineˇ",
      "expected": "- [x] Ship engine\n- [ ] ˇ"
    },
    {
      "id": "newline_empty_task_item_clears_line",
      "action": "newline",
      "input": "- [ ] ˇ",
      "expected": "\nˇ"
    },
    {
      "id": "newline_unordered_bullet_item",
      "action": "newline",
      "input": "- First bulletˇ",
      "expected": "- First bullet\n- ˇ"
    },
    {
      "id": "newline_empty_unordered_bullet_clears_line",
      "action": "newline",
      "input": "  *   ˇ",
      "expected": "\nˇ"
    },
    {
      "id": "newline_ordered_list_increments_number",
      "action": "newline",
      "input": "  1. First itemˇ",
      "expected": "  1. First item\n  2. ˇ"
    },
    {
      "id": "newline_ordered_paren_list_increments_number",
      "action": "newline",
      "input": "3) Third stepˇ",
      "expected": "3) Third step\n4) ˇ"
    },
    {
      "id": "newline_blockquote_continues_prefix",
      "action": "newline",
      "input": "> Quoted thoughtˇ",
      "expected": "> Quoted thought\n> ˇ"
    },
    {
      "id": "newline_plain_paragraph_splits_line",
      "action": "newline",
      "input": "Helloˇ world",
      "expected": "Hello\nˇ world"
    },
    {
      "id": "toggle_bold_wraps_word_under_cursor",
