      "level": 3,
      "input": "# Main ˇTitle",
      "expected": "### Main ˇTitle"
    },
    {
      "id": "set_heading_level_zero_strips_hashes",
      "action": "set_heading_level",
      "level": 0,
      "input": "## Section ˇTitle",
      "expected": "Section ˇTitle"
    },
    {
      "id": "toggle_task_checkbox_checks_open_item",
      "action": "toggle_task_checkbox",
      "input": "- [ ] Write ˇspecs",
