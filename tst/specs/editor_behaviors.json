    },
    {
      "id": "toggle_task_checkbox_unchecks_done_item",
      "action": "toggle_task_checkbox",
      "input": "- [x] Write ˇspecs",
      "expected": "- [ ] Write ˇspecs"
    }
  ],
  "fold_reveal_cases": [
