load("@bazel_skylib//rules:common_settings.bzl", "bool_flag", "string_flag")

package(default_visibility = ["//visibility:public"])

exports_files([
    "BUILD.bazel",
    "defs.bzl",
    "workspace_status.sh",
])

# Set by --config=release. Release builds read STABLE_FOLIO_* stamp keys.
bool_flag(
    name = "release",
    build_setting_default = False,
)

config_setting(
    name = "release_build",
    flag_values = {":release": "true"},
)

# Keychain identity that signs Folio.app and Folio.dmg inside //:FolioDmg.
# Empty or "-" keeps the ad hoc signature from rules_apple.
string_flag(
    name = "codesign_identity",
    build_setting_default = "",
)
