load("@bazel_skylib//lib:selects.bzl", "selects")
load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")

package(default_visibility = ["//visibility:public"])

exports_files(["workspace_status.sh"])

# Set by --config=release. Release builds read STABLE_FOLIO_* stamp keys.
bool_flag(
    name = "release",
    build_setting_default = False,
)

config_setting(
    name = "release_build",
    flag_values = {":release": "true"},
)

# True when rules_apple signs ad hoc: no identity, or the "-" pseudo-identity.
selects.config_setting_group(
    name = "adhoc_signing",
    match_any = [
        ":no_signing_identity",
        ":dash_signing_identity",
    ],
)

config_setting(
    name = "no_signing_identity",
    flag_values = {"@build_bazel_rules_apple//apple/build_settings:signing_certificate_name": ""},
)

config_setting(
    name = "dash_signing_identity",
    flag_values = {"@build_bazel_rules_apple//apple/build_settings:signing_certificate_name": "-"},
)
