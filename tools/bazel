#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
BAZELISK_BIN="$SCRIPT_DIR/.bazelisk"

if [[ -x "$BAZELISK_BIN" ]]; then
  BAZEL_CMD="$BAZELISK_BIN"
elif command -v bazelisk >/dev/null 2>&1; then
  BAZEL_CMD="bazelisk"
elif command -v bazel >/dev/null 2>&1; then
  BAZEL_CMD="bazel"
else
  mkdir -p "$SCRIPT_DIR"
  ARCH="$(uname -m)"
  if [[ "$ARCH" == "arm64" ]]; then
    URL="https://github.com/bazelbuild/bazelisk/releases/download/v1.25.0/bazelisk-darwin-arm64"
  else
    URL="https://github.com/bazelbuild/bazelisk/releases/download/v1.25.0/bazelisk-darwin-amd64"
  fi
  echo "[Folio] Downloading Bazelisk to $BAZELISK_BIN..." >&2
  curl -fsSL "$URL" -o "$BAZELISK_BIN"
  chmod +x "$BAZELISK_BIN"
  BAZEL_CMD="$BAZELISK_BIN"
fi

if [[ "${1:-}" == "build" ]]; then
  "$BAZEL_CMD" "$@"
  BUILT_APP="$REPO_ROOT/bazel-bin/macos/FolioApp/FolioApp_archive-root/Folio.app"
  if [[ -d "$BUILT_APP" ]]; then
    rm -rf "$REPO_ROOT/Folio.app"
    cp -R "$BUILT_APP" "$REPO_ROOT/Folio.app"
    chmod -R u+w "$REPO_ROOT/Folio.app"
  fi
else
  exec "$BAZEL_CMD" "$@"
fi
