load("@build_bazel_rules_swift//swift:swift_interop_hint.bzl", "swift_interop_hint")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_static_library", "rust_test", "rustfmt_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "BUILD.bazel",
    "Cargo.toml",
])

ENGINE_SRCS = glob(["src/**/*.rs"])

ENGINE_DEPS = [
    "@crates//:biblatex",
    "@crates//:latex-rust",
    "@crates//:merman",
] + select({
    # The wasm build stubs out cmark (see src/markdown/cmark_sys.rs).
    "@platforms//cpu:wasm32": [],
    "//conditions:default": ["@cmark_gfm//:cmark_gfm"],
})

# Native Rust library consumed by Zed extension crate (//zed/folio_zed_extension)
rust_library(
    name = "folio_engine",
    srcs = ENGINE_SRCS,
    crate_name = "folio_engine",
    edition = "2021",
    deps = ENGINE_DEPS,
)

# Static C-ABI archive consumed by Swift / macOS AppKit (//macos/FolioApp)
rust_static_library(
    name = "folio_engine_static",
    srcs = ENGINE_SRCS,
    crate_name = "folio_engine",
    edition = "2021",
    deps = ENGINE_DEPS,
)

swift_interop_hint(
    name = "folio_engine_swift_interop",
    module_name = "FolioEngineFFI",
)

cc_library(
    name = "folio_engine_ffi",
    hdrs = ["include/folio_engine.h"],
    aspect_hints = [":folio_engine_swift_interop"],
    includes = ["include"],
    linkopts = [
        "-Wl,-dead_strip",
    ],
    deps = [
        ":folio_engine_static",
        "@cmark_gfm",
    ],
)

# One test target per tst/*.rs file, so a new test file cannot be left unregistered.
ENGINE_TESTS = glob(["tst/*.rs"])

[
    rust_test(
        name = src.removeprefix("tst/").removesuffix(".rs"),
        srcs = [src],
        data = [
            "tst/corpus/latex_commands.tex",
            "tst/golden/latex_scan.txt",
            "//tst/specs:all_behavior_specs",
            "@markdown_spec//:all_spec_files",
        ],
        edition = "2021",
        env = {
            "LATEX_CORPUS": "$(rootpath tst/corpus/latex_commands.tex)",
            "LATEX_GOLDEN": "$(rootpath tst/golden/latex_scan.txt)",
        },
        deps = [":folio_engine"],
    )
    for src in ENGINE_TESTS
]

rustfmt_test(
    name = "rustfmt",
    targets = [":folio_engine"] + [
        ":" + src.removeprefix("tst/").removesuffix(".rs")
        for src in ENGINE_TESTS
    ],
)
