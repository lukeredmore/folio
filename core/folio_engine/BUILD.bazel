load("@build_bazel_rules_swift//swift:swift_interop_hint.bzl", "swift_interop_hint")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_static_library", "rust_test")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

ENGINE_SRCS = [
    "src/ffi/editing_ffi.rs",
    "src/ffi/latex_block_ffi.rs",
    "src/ffi/latex_ffi.rs",
    "src/ffi/markdown_ffi.rs",
    "src/ffi/math_ffi.rs",
    "src/ffi/mod.rs",
    "src/latex/bibtex.rs",
    "src/latex/directives.rs",
    "src/latex/inline_scan.rs",
    "src/latex/inline_scan_cmds.rs",
    "src/latex/line_classify.rs",
    "src/latex/macro_math.rs",
    "src/latex/mod.rs",
    "src/latex/scanner.rs",
    "src/latex/types.rs",
    "src/lib.rs",
    "src/markdown/analyzer.rs",
    "src/markdown/block_handlers.rs",
    "src/markdown/block_scanner.rs",
    "src/markdown/cmark_ast.rs",
    "src/markdown/cmark_sys.rs",
    "src/markdown/editing.rs",
    "src/markdown/html_inline.rs",
    "src/markdown/inline_helpers.rs",
    "src/markdown/inline_scanner.rs",
    "src/markdown/mod.rs",
    "src/markdown/newline.rs",
    "src/markdown/tables.rs",
    "src/markdown/types.rs",
    "src/math/ast.rs",
    "src/math/commands.rs",
    "src/math/layout.rs",
    "src/math/mod.rs",
    "src/math/parser.rs",
    "src/math/symbols.rs",
    "src/mermaid/mod.rs",
    "src/mermaid/svg_inline.rs",
    "src/mermaid/svg_markers.rs",
    "src/mermaid/svg_norm.rs",
    "src/mermaid/theme.rs",
    "src/reflow/mod.rs",
    "src/reflow/protected.rs",
    "src/stats.rs",
    "src/theme.rs",
]

# Native Rust library consumed by Zed extension crate (//zed/folio_zed_extension)
rust_library(
    name = "folio_engine",
    srcs = ENGINE_SRCS,
    crate_name = "folio_engine",
    edition = "2021",
    deps = [
        "@cmark_gfm//:cmark_gfm",
        "@crates//:merman",
    ],
)

# Static C-ABI archive consumed by Swift / macOS AppKit (//macos/FolioApp)
rust_static_library(
    name = "folio_engine_static",
    srcs = ENGINE_SRCS,
    crate_name = "folio_engine",
    edition = "2021",
    deps = [
        "@cmark_gfm//:cmark_gfm",
        "@crates//:merman",
    ],
)

swift_interop_hint(
    name = "folio_engine_swift_interop",
    module_name = "FolioEngineFFI",
)

cc_library(
    name = "folio_engine_ffi",
    hdrs = ["include/folio_engine.h"],
    aspect_hints = [":folio_engine_swift_interop"],
    includes = ["include"],
    linkopts = [
        "-Wl,-dead_strip",
    ],
    deps = [
        ":folio_engine_static",
        "@cmark_gfm//:cmark_gfm",
    ],
)

rust_test(
    name = "folio_engine_test",
    srcs = ["tst/engine_tests.rs"],
    edition = "2021",
    deps = [":folio_engine"],
)

rust_test(
    name = "cmark_gfm_spec_test",
    srcs = ["tst/cmark_gfm_spec_tests.rs"],
    data = [
        "@markdown_spec//:all_spec_files",
    ],
    edition = "2021",
    deps = [":folio_engine"],
)

rust_test(
    name = "markdown_scan_test",
    srcs = ["tst/markdown_scan_tests.rs"],
    edition = "2021",
    deps = [":folio_engine"],
)

rust_test(
    name = "reflow_test",
    srcs = ["tst/reflow_tests.rs"],
    edition = "2021",
    deps = [":folio_engine"],
)

rust_test(
    name = "behavior_suite_test",
    srcs = ["tst/behavior_suite.rs"],
    data = [
        "//tst/specs:all_behavior_specs",
    ],
    edition = "2021",
    deps = [":folio_engine"],
)

rust_test(
    name = "latex_scan_test",
    srcs = ["tst/latex_scan_tests.rs"],
    edition = "2021",
    deps = [":folio_engine"],
)
