load("@rules_rust//rust:defs.bzl", "rust_library", "rust_shared_library", "rust_test")

package(default_visibility = ["//visibility:public"])

MOD_SRCS = [
    "src/editor_session.rs",
    "src/ffi.rs",
    "src/ffi_controller.rs",
    "src/inlay_folding.rs",
    "src/keystroke_controller.rs",
    "src/keystroke_helpers.rs",
    "src/lib.rs",
    "src/markdown_formatting.rs",
    "src/math_canvas.rs",
    "src/text_navigation.rs",
    "src/theme_sync.rs",
]

rust_library(
    name = "folio_zed_mod",
    srcs = MOD_SRCS,
    crate_name = "folio_zed_mod",
    edition = "2021",
    deps = [
        "//core/folio_engine",
    ],
)

rust_shared_library(
    name = "folio_zed_mod_dylib",
    srcs = MOD_SRCS,
    crate_name = "folio_zed_mod",
    edition = "2021",
    deps = [
        "//core/folio_engine",
    ],
)

rust_test(
    name = "folio_zed_mod_test",
    srcs = ["tst/session_tests.rs"],
    edition = "2021",
    deps = [
        ":folio_zed_mod",
        "//core/folio_engine",
    ],
)

rust_test(
    name = "folio_zed_mod_ffi_test",
    srcs = ["tst/ffi_tests.rs"],
    edition = "2021",
    deps = [
        ":folio_zed_mod",
        "//core/folio_engine",
    ],
)

rust_test(
    name = "folio_zed_mod_controller_test",
    srcs = ["tst/controller_tests.rs"],
    edition = "2021",
    deps = [
        ":folio_zed_mod",
        "//core/folio_engine",
    ],
)

rust_test(
    name = "folio_zed_mod_behavior_test",
    srcs = ["tst/behavior_suite.rs"],
    data = [
        "//tst/specs:all_behavior_specs",
    ],
    edition = "2021",
    deps = [
        ":folio_zed_mod",
        "//core/folio_engine",
    ],
)

alias(
    name = "zed_with_folio_mod",
    actual = "//third_party/zed:zed_with_folio_mod",
)
