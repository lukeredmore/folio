rust_test(
    name = "opentype_zed_mod_test",
    crate = ":opentype_zed_mod",
    edition = "2021",
)

alias(
    name = "zed_with_opentype_mod",
    actual = "//third_party/zed:zed_with_opentype_mod",
)
