load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "opentype_zed_mod",
    srcs = [
        "src/editor_session.rs",
        "src/inlay_folding.rs",
        "src/lib.rs",
        "src/math_canvas.rs",
        "src/theme_sync.rs",
    ],
    crate_name = "opentype_zed_mod",
    edition = "2021",
    deps = [
        "//core/opentype_engine",
