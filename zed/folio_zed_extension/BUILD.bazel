load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "extension_bundle",
    srcs = [
        "extension.toml",
        "languages/markdown/config.toml",
        "languages/markdown/outline.scm",
    ],
)

rust_library(
    name = "folio_zed_extension",
    srcs = ["src/lib.rs"],
    compile_data = [
        "extension.toml",
        "languages/markdown/config.toml",
        "languages/markdown/outline.scm",
    ],
    crate_name = "folio_zed_extension",
    edition = "2021",
    deps = [
        "//core/folio_engine",
    ],
)

rust_test(
    name = "folio_zed_extension_test",
    srcs = ["tst/extension_tests.rs"],
    edition = "2021",
    deps = [
        ":folio_zed_extension",
        "//core/folio_engine",
    ],
)
