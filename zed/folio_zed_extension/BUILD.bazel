load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_python//python:defs.bzl", "py_test")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test", "rustfmt_test")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("//tools/release:defs.bzl", "opt_files", "zed_extension_manifest")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "folio_zed_extension",
    srcs = glob(["src/**/*.rs"]),
    compile_data = [
        "extension.toml",
        "languages/markdown/config.toml",
        "languages/markdown/outline.scm",
    ],
    crate_name = "folio_zed_extension",
    edition = "2021",
    deps = [
        "//core/folio_engine",
    ],
)

# One test target per tst/*.rs file, so a new test file cannot be left unregistered.
EXTENSION_TESTS = glob(["tst/*.rs"])

[
    rust_test(
        name = src.removeprefix("tst/").removesuffix(".rs"),
        srcs = [src],
        data = ["//tst/specs:all_behavior_specs"],
        edition = "2021",
        deps = [
            ":folio_zed_extension",
            "//core/folio_engine",
        ],
    )
    for src in EXTENSION_TESTS
]

rustfmt_test(
    name = "rustfmt",
    targets = [":folio_zed_extension"] + [
        ":" + src.removeprefix("tst/").removesuffix(".rs")
        for src in EXTENSION_TESTS
    ],
)

zed_extension_manifest(
    name = "stamped_manifest",
    src = "extension.toml",
)

# The folio-markdown-outline.tar.gz archive that ships in GitHub Releases.
pkg_tar(
    name = "archive",
    out = "folio-markdown-outline.tar.gz",
    extension = "tar.gz",
    files = {
        ":stamped_manifest": "extension.toml",
        "//zed/folio_zed_extension/wasm:extension_wasm": "extension.wasm",
        "languages/markdown/config.toml": "languages/markdown/config.toml",
        "languages/markdown/outline.scm": "languages/markdown/outline.scm",
    },
    mode = "0644",
)

py_test(
    name = "archive_test",
    srcs = ["tst/archive_test.py"],
    args = [
        "$(rootpath :archive)",
        "$(rootpath extension.toml)",
    ],
    data = [
        "extension.toml",
        ":archive",
    ],
)

opt_files(
    name = "archive_opt",
    srcs = [":archive"],
    tags = ["manual"],
)

# bazel run //zed/folio_zed_extension:install
sh_binary(
    name = "install",
    srcs = ["install.sh"],
    args = ["$(rootpath :archive_opt)"],
    data = [":archive_opt"],
    tags = ["manual"],
)
