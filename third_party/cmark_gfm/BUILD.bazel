load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "cmark_gfm",
    srcs = glob(
        [
            "src/*.c",
            "src/*.inc",
            "extensions/*.c",
        ],
        exclude = ["src/main.c"],
    ),
    hdrs = glob([
        "src/*.h",
        "extensions/*.h",
    ]),
    copts = [
        "-std=c99",
        "-DCMARK_GFM_STATIC_DEFINE",
        "-DCMARK_GFM_EXTENSIONS_STATIC_DEFINE",
        "-Wno-unused-parameter",
    ],
    includes = [
        "extensions",
        "src",
    ],
)
