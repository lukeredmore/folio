+fn parse_list_line(clean_line: &str, line_byte_start: usize) -> Option<ParsedListLine> {
+    let bytes = clean_line.as_bytes();
+    let mut ws_end = 0;
+    let mut indent_spaces = 0;
+    while ws_end < bytes.len() && (bytes[ws_end] == b' ' || bytes[ws_end] == b'\t') {
+        indent_spaces += if bytes[ws_end] == b'\t' { 4 } else { 1 };
+        ws_end += 1;
+    }
+    let after_ws = &clean_line[ws_end..];
+    if after_ws.is_empty() {
+        return None;
+    }
+
+    let first = after_ws.as_bytes()[0];
+    if (first == b'-' || first == b'*' || first == b'+')
+        && after_ws.len() >= 2
+        && (after_ws.as_bytes()[1] == b' ' || after_ws.as_bytes()[1] == b'\t')
+    {
+        // Avoid matching horizontal rules like "* * *" or "- - -"
+        let trimmed_rest = after_ws[1..].trim();
+        if !trimmed_rest.is_empty()
+            && trimmed_rest
+                .bytes()
+                .all(|b| b == first || b == b' ' || b == b'\t')
+        {
+            return None;
+        }
+
+        let mut bullet_ws_end = 1;
+        while bullet_ws_end < after_ws.len()
+            && (after_ws.as_bytes()[bullet_ws_end] == b' '
+                || after_ws.as_bytes()[bullet_ws_end] == b'\t')
+        {
+            bullet_ws_end += 1;
+        }
+        let after_bullet = &after_ws[bullet_ws_end..];
+        if after_bullet.len() >= 4 {
+            let box_slice = &after_bullet[..3];
+            let next_byte = after_bullet.as_bytes()[3];
+            if (box_slice == "[ ]" || box_slice == "[x]" || box_slice == "[X]")
+                && (next_byte == b' ' || next_byte == b'\t')
+            {
+                let checked = box_slice != "[ ]";
+                let bracket_start = line_byte_start + ws_end + bullet_ws_end;
+                let bracket_end = bracket_start + 3;
+                let fold_end = bracket_end + 1;
+                let line_end = line_byte_start + clean_line.len();
+                return Some(ParsedListLine::Task {
+                    indent_spaces,
+                    fold_byte_range: line_byte_start..fold_end,
+                    bracket_byte_range: bracket_start..bracket_end,
+                    content_byte_range: fold_end..line_end,
+                    checked,
+                });
+            }
+        }
+
+        let fold_end = line_byte_start + ws_end + bullet_ws_end;
+        return Some(ParsedListLine::Unordered {
+            indent_spaces,
+            fold_byte_range: line_byte_start..fold_end,
+        });
+    }
+
+    let mut digit_end = 0;
+    while digit_end < after_ws.len() && after_ws.as_bytes()[digit_end].is_ascii_digit() {
+        digit_end += 1;
+    }
+    if digit_end > 0
+        && digit_end + 1 < after_ws.len()
+        && after_ws.as_bytes()[digit_end] == b'.'
+        && (after_ws.as_bytes()[digit_end + 1] == b' '
+            || after_ws.as_bytes()[digit_end + 1] == b'\t')
+    {
+        let marker_start = line_byte_start + ws_end;
+        let marker_end = marker_start + digit_end + 2;
+        return Some(ParsedListLine::Ordered {
+            marker_byte_range: marker_start..marker_end,
+        });
+    }
+
+    None
+}
