diff --git a/crates/markdown/src/folio_dylib.rs b/crates/markdown/src/folio_dylib.rs
new file mode 100644
index 0000000..5dd84f8
--- /dev/null
+++ b/crates/markdown/src/folio_dylib.rs
@@ -0,0 +1,348 @@
+use std::ffi::{CStr, CString, c_void};
+use std::os::raw::{c_char, c_int};
+use std::path::PathBuf;
+use std::sync::OnceLock;
+
+#[repr(C)]
+struct FolioZedSvgResult {
+    svg: *mut c_char,
+    width: f32,
+    height: f32,
+}
+
+#[repr(C)]
+struct FolioZedMathPrim {
+    kind: u32,
+    x: f32,
+    y: f32,
+    width: f32,
+    height: f32,
+    extra_f32_1: f32,
+    extra_f32_2: f32,
+    italic: bool,
+    bold: bool,
+    serif: bool,
+    text: *mut c_char,
+}
+
+#[repr(C)]
+struct FolioZedMathCanvas {
+    width: f32,
+    ascent: f32,
+    descent: f32,
+    primitives: *mut FolioZedMathPrim,
+    primitive_count: usize,
+    plain_text_fallback: *mut c_char,
+}
+
+#[repr(C)]
+struct FolioZedNewlineResult {
+    kind: u32,
+    prefix: *mut c_char,
+}
+
+#[derive(Debug, Clone, PartialEq)]
+pub enum GpuiMathPrimitive {
+    ShapedGlyphRun {
+        text: String,
+        origin_x: f32,
+        baseline_y: f32,
+        font_size: f32,
+        italic: bool,
+        bold: bool,
+        serif: bool,
+    },
+    RuleQuad {
+        x: f32,
+        y: f32,
+        width: f32,
+        height: f32,
+    },
+    RadicalStroke {
+        x: f32,
+        top_y: f32,
+        bottom_y: f32,
+        hook_width: f32,
+        radicand_width: f32,
+        line_width: f32,
+    },
+}
+
+#[derive(Debug, Clone, PartialEq)]
+pub struct GpuiMathCanvasDescriptor {
+    pub width: f32,
+    pub ascent: f32,
+    pub descent: f32,
+    pub primitives: Vec<GpuiMathPrimitive>,
+    pub plain_text_accessibility: String,
+}
+
+impl GpuiMathCanvasDescriptor {
+    pub fn total_height(&self) -> f32 {
+        (self.ascent + self.descent).max(1.0)
+    }
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum NewlineAction {
+    Default,
+    ClearEmptyListLine,
+    InsertPrefix(String),
+}
+
+struct FolioDylibApi {
+    normalize_svg: unsafe extern "C" fn(*const c_char) -> *mut FolioZedSvgResult,
+    render_mermaid_svg: unsafe extern "C" fn(*const c_char, bool) -> *mut FolioZedSvgResult,
+    free_svg_result: unsafe extern "C" fn(*mut FolioZedSvgResult),
+    build_math_canvas: unsafe extern "C" fn(*const c_char, f32, bool) -> *mut FolioZedMathCanvas,
+    free_math_canvas: unsafe extern "C" fn(*mut FolioZedMathCanvas),
+    on_editor_newline: unsafe extern "C" fn(*const c_char) -> FolioZedNewlineResult,
+    free_newline_result: unsafe extern "C" fn(FolioZedNewlineResult),
+    set_code_fence_language:
+        unsafe extern "C" fn(*const c_char, usize, *const c_char) -> *mut c_char,
+    free_string: unsafe extern "C" fn(*mut c_char),
+}
+
+unsafe impl Send for FolioDylibApi {}
+unsafe impl Sync for FolioDylibApi {}
+
+unsafe extern "C" {
+    fn dlopen(filename: *const c_char, flags: c_int) -> *mut c_void;
+    fn dlsym(handle: *mut c_void, symbol: *const c_char) -> *mut c_void;
+}
+
+const RTLD_LAZY: c_int = 0x1;
+const RTLD_LOCAL: c_int = 0x4;
+
+fn candidate_dylib_paths() -> Vec<PathBuf> {
+    let mut paths = Vec::new();
+    if let Ok(env_path) = std::env::var("FOLIO_ZED_MOD_DYLIB_PATH")
+        && !env_path.is_empty()
+    {
+        paths.push(PathBuf::from(env_path));
+    }
+    if let Ok(exe_path) = std::env::current_exe()
+        && let Some(macos_dir) = exe_path.parent()
+    {
+        paths.push(macos_dir.join("../Frameworks/libfolio_zed_mod.dylib"));
+        paths.push(macos_dir.join("libfolio_zed_mod.dylib"));
+    }
+    let manifest_dir = PathBuf::from(env!("CARGO_MANIFEST_DIR"));
+    let repo_root = manifest_dir.join("../../../../..");
+    paths.push(repo_root.join("bazel-bin/zed/folio_zed_mod/libfolio_zed_mod.dylib"));
+    paths.push(repo_root.join("target/release/libfolio_zed_mod.dylib"));
+    paths.push(repo_root.join("target/debug/libfolio_zed_mod.dylib"));
+    paths
+}
+
+unsafe fn load_sym<T: Copy>(handle: *mut c_void, name: &[u8]) -> Option<T> {
+    let sym = unsafe { dlsym(handle, name.as_ptr().cast::<c_char>()) };
+    if sym.is_null() {
+        None
+    } else {
+        Some(unsafe { std::mem::transmute_copy(&sym) })
+    }
+}
+
+fn api() -> Option<&'static FolioDylibApi> {
+    static API: OnceLock<Option<FolioDylibApi>> = OnceLock::new();
+    API.get_or_init(|| {
+        for path in candidate_dylib_paths() {
+            if !path.exists() {
+                continue;
+            }
+            let Ok(c_path) = CString::new(path.to_string_lossy().as_bytes()) else {
+                continue;
+            };
+            unsafe {
+                let handle = dlopen(c_path.as_ptr(), RTLD_LAZY | RTLD_LOCAL);
+                if handle.is_null() {
+                    continue;
+                }
+                return Some(FolioDylibApi {
+                    normalize_svg: load_sym(handle, b"folio_zed_mod_normalize_svg\0")?,
+                    render_mermaid_svg: load_sym(handle, b"folio_zed_mod_render_mermaid_svg\0")?,
+                    free_svg_result: load_sym(handle, b"folio_zed_mod_free_svg_result\0")?,
+                    build_math_canvas: load_sym(handle, b"folio_zed_mod_build_math_canvas\0")?,
+                    free_math_canvas: load_sym(handle, b"folio_zed_mod_free_math_canvas\0")?,
+                    on_editor_newline: load_sym(handle, b"folio_zed_mod_on_editor_newline\0")?,
+                    free_newline_result: load_sym(handle, b"folio_zed_mod_free_newline_result\0")?,
+                    set_code_fence_language: load_sym(
+                        handle,
+                        b"folio_zed_mod_set_code_fence_language\0",
+                    )?,
+                    free_string: load_sym(handle, b"folio_zed_mod_free_string\0")?,
+                });
+            }
+        }
+        None
+    })
+    .as_ref()
+}
+
+pub fn normalize_svg_markup(raw_svg: &str) -> Option<(String, f32, f32)> {
+    let dylib = api()?;
+    let c_raw = CString::new(raw_svg).ok()?;
+    unsafe {
+        let res = (dylib.normalize_svg)(c_raw.as_ptr());
+        if res.is_null() {
+            return None;
+        }
+        let svg = if (*res).svg.is_null() {
+            String::new()
+        } else {
+            CStr::from_ptr((*res).svg).to_string_lossy().into_owned()
+        };
+        let out = (svg, (*res).width, (*res).height);
+        (dylib.free_svg_result)(res);
+        Some(out)
+    }
+}
+
+pub fn render_mermaid_to_svg(source: &str, is_dark: bool) -> Option<String> {
+    let dylib = api()?;
+    let c_src = CString::new(source).ok()?;
+    unsafe {
+        let res = (dylib.render_mermaid_svg)(c_src.as_ptr(), is_dark);
+        if res.is_null() {
+            return None;
+        }
+        let svg = if (*res).svg.is_null() {
+            String::new()
+        } else {
+            CStr::from_ptr((*res).svg).to_string_lossy().into_owned()
+        };
+        (dylib.free_svg_result)(res);
+        (!svg.is_empty()).then_some(svg)
+    }
+}
+
+pub fn build_gpui_math_canvas(
+    latex: &str,
+    font_size_px: f32,
+    display_mode: bool,
+) -> GpuiMathCanvasDescriptor {
+    let Some(dylib) = api() else {
+        return GpuiMathCanvasDescriptor {
+            width: font_size_px,
+            ascent: font_size_px * 0.8,
+            descent: font_size_px * 0.2,
+            primitives: Vec::new(),
+            plain_text_accessibility: latex.to_string(),
+        };
+    };
+    let c_latex = CString::new(latex).unwrap_or_default();
+    unsafe {
+        let ptr = (dylib.build_math_canvas)(c_latex.as_ptr(), font_size_px, display_mode);
+        if ptr.is_null() {
+            return GpuiMathCanvasDescriptor {
+                width: font_size_px,
+                ascent: font_size_px * 0.8,
+                descent: font_size_px * 0.2,
+                primitives: Vec::new(),
+                plain_text_accessibility: latex.to_string(),
+            };
+        }
+        let slice = if (*ptr).primitives.is_null() || (*ptr).primitive_count == 0 {
+            &[]
+        } else {
+            std::slice::from_raw_parts((*ptr).primitives, (*ptr).primitive_count)
+        };
+        let mut primitives = Vec::with_capacity(slice.len());
+        for prim in slice {
+            match prim.kind {
+                0 => {
+                    let text = if prim.text.is_null() {
+                        String::new()
+                    } else {
+                        CStr::from_ptr(prim.text).to_string_lossy().into_owned()
+                    };
+                    primitives.push(GpuiMathPrimitive::ShapedGlyphRun {
+                        text,
+                        origin_x: prim.x,
+                        baseline_y: prim.y,
+                        font_size: prim.height,
+                        italic: prim.italic,
+                        bold: prim.bold,
+                        serif: prim.serif,
+                    });
+                }
+                1 => primitives.push(GpuiMathPrimitive::RuleQuad {
+                    x: prim.x,
+                    y: prim.y,
+                    width: prim.width,
+                    height: prim.height,
+                }),
+                2 => primitives.push(GpuiMathPrimitive::RadicalStroke {
+                    x: prim.x,
+                    top_y: prim.y,
+                    bottom_y: prim.height,
+                    hook_width: prim.width,
+                    radicand_width: prim.extra_f32_1,
+                    line_width: prim.extra_f32_2,
+                }),
+                _ => {}
+            }
+        }
+        let plain_text_accessibility = if (*ptr).plain_text_fallback.is_null() {
+            String::new()
+        } else {
+            CStr::from_ptr((*ptr).plain_text_fallback)
+                .to_string_lossy()
+                .into_owned()
+        };
+        let desc = GpuiMathCanvasDescriptor {
+            width: (*ptr).width,
+            ascent: (*ptr).ascent,
+            descent: (*ptr).descent,
+            primitives,
+            plain_text_accessibility,
+        };
+        (dylib.free_math_canvas)(ptr);
+        desc
+    }
+}
+
+pub fn on_editor_newline(line_up_to_cursor: &str) -> NewlineAction {
+    let Some(dylib) = api() else {
+        return NewlineAction::Default;
+    };
+    let Ok(c_line) = CString::new(line_up_to_cursor) else {
+        return NewlineAction::Default;
+    };
+    unsafe {
+        let res = (dylib.on_editor_newline)(c_line.as_ptr());
+        let action = match res.kind {
+            1 => NewlineAction::ClearEmptyListLine,
+            2 if !res.prefix.is_null() => NewlineAction::InsertPrefix(
+                CStr::from_ptr(res.prefix).to_string_lossy().into_owned(),
+            ),
+            _ => NewlineAction::Default,
+        };
+        (dylib.free_newline_result)(res);
+        action
+    }
+}
+
+pub fn set_code_fence_language(
+    source: &str,
+    fence_start_byte_offset: usize,
+    new_language: &str,
+) -> Option<String> {
+    let dylib = api()?;
+    let c_src = CString::new(source).ok()?;
+    let c_lang = CString::new(new_language).ok()?;
+    unsafe {
+        let ptr = (dylib.set_code_fence_language)(
+            c_src.as_ptr(),
+            fence_start_byte_offset,
+            c_lang.as_ptr(),
+        );
+        if ptr.is_null() {
+            return None;
+        }
+        let out = CStr::from_ptr(ptr).to_string_lossy().into_owned();
+        (dylib.free_string)(ptr);
+        Some(out)
+    }
+}
