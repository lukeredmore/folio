+    #[test]
+    fn test_toggle_inline_delimiter_and_heading_shortcuts() {
+        // Wrap selection with **
+        let (range, repl, sel) = toggle_inline_delimiter("hello world", 0, 5, "**");
+        assert_eq!(range, 0..5);
+        assert_eq!(repl, "**hello**");
+        assert_eq!(sel, 2..7);
+
+        // Unwrap when selection is inside existing **hello**
+        let (range, repl, sel) = toggle_inline_delimiter("**hello** world", 2, 7, "**");
+        assert_eq!(range, 0..9);
+        assert_eq!(repl, "hello");
+        assert_eq!(sel, 0..5);
+
+        // Toggle word under collapsed cursor with *
+        let (range, repl, sel) = toggle_inline_delimiter("hello world", 2, 2, "*");
+        assert_eq!(range, 0..5);
+        assert_eq!(repl, "*hello*");
+        assert_eq!(sel, 3..3);
+
+        // Unwrap word under collapsed cursor inside *hello*
+        let (range, repl, sel) = toggle_inline_delimiter("*hello* world", 3, 3, "*");
+        assert_eq!(range, 0..7);
+        assert_eq!(repl, "hello");
+        assert_eq!(sel, 2..2);
+
+        // Heading level toggle
+        let (range, repl, sel) = toggle_heading_level("Title\nBody", 2, 2);
+        assert_eq!(range, 0..0);
+        assert_eq!(repl, "## ");
+        assert_eq!(sel, 5..5);
+
+        // Toggling same heading level removes prefix
+        let (range, repl, sel) = toggle_heading_level("## Title\nBody", 5, 2);
+        assert_eq!(range, 0..3);
+        assert_eq!(repl, "");
+        assert_eq!(sel, 2..2);
+
+        // Surrounding code span delimiters
+        let src = "Use `cargo test` now";
+        let (open, close) = surrounding_code_span_delimiters(src, &(5..15)).unwrap();
+        assert_eq!(&src[open], "`");
+        assert_eq!(&src[close], "`");
+
+        // Bold + italic toggle: Cmd+I (*) on **bold** wraps to ***bold*** instead of corrupting
+        let (range, repl, sel) = toggle_inline_delimiter("**bold**", 2, 6, "*");
+        assert_eq!(range, 2..6);
+        assert_eq!(repl, "*bold*");
+        assert_eq!(sel, 3..7);
+
+        // Multi-byte UTF-8 char boundary safety
+        let utf8_src = "Héllo 世界";
+        let (range, repl, _) = toggle_inline_delimiter(utf8_src, 2, 2, "**");
+        assert!(utf8_src.is_char_boundary(range.start));
+        assert!(utf8_src.is_char_boundary(range.end));
+        assert_eq!(repl, "**Héllo**");
+    }
