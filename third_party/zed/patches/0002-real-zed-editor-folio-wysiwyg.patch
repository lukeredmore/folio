+fn snap_char_boundary_left(source: &str, offset: usize) -> usize {
+    let mut idx = offset.min(source.len());
+    while idx > 0 && !source.is_char_boundary(idx) {
+        idx -= 1;
+    }
+    idx
+}
+
+fn snap_char_boundary_right(source: &str, offset: usize) -> usize {
+    let len = source.len();
+    let mut idx = offset.min(len);
+    while idx < len && !source.is_char_boundary(idx) {
+        idx += 1;
+    }
+    idx
+}
