+fn clean_inline_markdown(input: &str) -> String {
+    let mut out = String::with_capacity(input.len());
+    let chars: Vec<char> = input.chars().collect();
+    let mut i = 0;
+    while i < chars.len() {
+        if i + 1 < chars.len()
+            && ((chars[i] == '*' && chars[i + 1] == '*')
+                || (chars[i] == '~' && chars[i + 1] == '~')
+                || (chars[i] == '=' && chars[i + 1] == '='))
+        {
+            i += 2;
+            continue;
+        }
+        if chars[i] == '`' || chars[i] == '*' {
+            i += 1;
+            continue;
+        }
+        if chars[i] == '[' {
+            // Convert [label](url) -> label
+            if let Some(close_bracket) = chars[i + 1..].iter().position(|&c| c == ']') {
+                let close_idx = i + 1 + close_bracket;
+                if close_idx + 1 < chars.len() && chars[close_idx + 1] == '(' {
+                    if let Some(close_paren) =
+                        chars[close_idx + 2..].iter().position(|&c| c == ')')
+                    {
+                        for &ch in &chars[i + 1..close_idx] {
+                            out.push(ch);
+                        }
+                        i = close_idx + 2 + close_paren + 1;
+                        continue;
+                    }
+                }
+            }
+        }
+        out.push(chars[i]);
+        i += 1;
+    }
+    out
+}
