+fn render_gpui_math_canvas_element(
+    descriptor: folio_dylib::GpuiMathCanvasDescriptor,
+    base_text_style: TextStyle,
+) -> AnyElement {
+    let width = px(descriptor.width.max(4.0));
+    let height = px(descriptor.total_height().max(12.0));
+    let primitives = descriptor.primitives;
+    let color = base_text_style.color;
+    let base_font = base_text_style.font();
+
+    gpui::canvas(
+        move |_bounds, _window, _cx| (),
+        move |bounds, (), window, cx| {
+            let origin = bounds.origin;
+            for prim in &primitives {
+                match prim {
+                    folio_dylib::GpuiMathPrimitive::ShapedGlyphRun {
+                        text,
+                        origin_x,
+                        baseline_y,
+                        font_size,
+                        italic,
+                        bold,
+                        ..
+                    } => {
+                        if text.is_empty() {
+                            continue;
+                        }
+                        let mut font = base_font.clone();
+                        if *italic {
+                            font.style = gpui::FontStyle::Italic;
+                        }
+                        if *bold {
+                            font.weight = gpui::FontWeight::BOLD;
+                        }
+                        let run = gpui::TextRun {
+                            len: text.len(),
+                            font,
+                            color,
+                            background_color: None,
+                            underline: None,
+                            strikethrough: None,
+                        };
+                        let fsize = px(*font_size);
+                        let shaped = window.text_system().shape_line(
+                            SharedString::from(text.clone()),
+                            fsize,
+                            &[run],
+                            None,
+                        );
+                        let top_y = (*baseline_y - *font_size * 0.8).max(0.0);
+                        let pos = point(origin.x + px(*origin_x), origin.y + px(top_y));
+                        let _ = shaped.paint(pos, fsize * 1.2, gpui::TextAlign::Left, None, window, cx);
+                    }
+                    folio_dylib::GpuiMathPrimitive::RuleQuad {
+                        x,
+                        y,
+                        width,
+                        height,
+                    } => {
+                        window.paint_quad(quad(
+                            Bounds {
+                                origin: point(origin.x + px(*x), origin.y + px(*y)),
+                                size: size(px((*width).max(1.0)), px((*height).max(1.0))),
+                            },
+                            px(0.0),
+                            color,
+                            Edges::default(),
+                            Hsla::transparent_black(),
+                            BorderStyle::default(),
+                        ));
+                    }
+                    folio_dylib::GpuiMathPrimitive::RadicalStroke {
+                        x,
+                        top_y,
+                        bottom_y,
+                        hook_width,
+                        radicand_width,
+                        line_width,
+                    } => {
+                        let stroke = px((*line_width).max(1.0));
+                        let stem_height = (*bottom_y - *top_y).max(2.0);
+                        // Left stem of radical
+                        window.paint_quad(quad(
+                            Bounds {
+                                origin: point(
+                                    origin.x + px(*x + *hook_width * 0.5),
+                                    origin.y + px(*top_y),
+                                ),
+                                size: size(stroke, px(stem_height)),
+                            },
+                            px(0.0),
+                            color,
+                            Edges::default(),
+                            Hsla::transparent_black(),
+                            BorderStyle::default(),
+                        ));
+                        // Top vinculum bar over radicand
+                        window.paint_quad(quad(
+                            Bounds {
+                                origin: point(
+                                    origin.x + px(*x + *hook_width),
+                                    origin.y + px(*top_y),
+                                ),
+                                size: size(px((*radicand_width).max(2.0)), stroke),
+                            },
+                            px(0.0),
+                            color,
+                            Edges::default(),
+                            Hsla::transparent_black(),
+                            BorderStyle::default(),
+                        ));
+                    }
+                }
+            }
+        },
+    )
+    .w(width)
+    .h(height)
+    .into_any_element()
+}
+
+fn render_code_block_language_button(
+    id: usize,
+    source: SharedString,
+    block_range: Range<usize>,
+    current_lang: String,
+    on_source_edit: SourceEditCallback,
+) -> AnyElement {
+    let trimmed_lang = current_lang.trim();
+    let label: SharedString = if trimmed_lang.is_empty() {
+        "plain".into()
+    } else {
+        SharedString::from(trimmed_lang.to_string())
+    };
+
+    div()
+        .id(("code-block-language-badge", id))
+        .px_1p5()
+        .py_0p5()
+        .rounded_sm()
+        .text_xs()
+        .cursor_pointer()
+        .tooltip(Tooltip::text("Click to cycle code block language"))
+        .child(Label::new(label).size(LabelSize::XSmall).color(Color::Muted))
+        .on_click(move |_event, window, cx| {
+            const LANGUAGES: &[&str] = &[
+                "rust",
+                "python",
+                "typescript",
+                "javascript",
+                "bash",
+                "json",
+                "markdown",
+                "go",
+                "sql",
+                "c",
+                "cpp",
+                "html",
+                "css",
+                "yaml",
+                "toml",
+                "plain",
+            ];
+            let current = {
+                let s = current_lang.trim();
+                if s.is_empty() { "plain" } else { s }
+            };
+            let next_idx = LANGUAGES
+                .iter()
+                .position(|&lang| lang.eq_ignore_ascii_case(current))
+                .map(|idx| (idx + 1) % LANGUAGES.len())
+                .unwrap_or(0);
+            let next_lang = LANGUAGES[next_idx];
+            let target_lang = if next_lang == "plain" { "" } else { next_lang };
+
+            if let Some(block_slice) = source.get(block_range.start..block_range.end) {
+                let rel_end = block_slice.find('\n').unwrap_or(block_slice.len());
+                let fence_line_range = block_range.start..(block_range.start + rel_end);
+                if let Some(fence_line) = source.get(fence_line_range.clone())
+                    && let Some(updated_line) =
+                        folio_dylib::set_code_fence_language(
+                            fence_line,
+                            0,
+                            target_lang,
+                        )
+                {
+                    let trimmed_line = updated_line.trim_end_matches('\n');
+                    on_source_edit(fence_line_range, trimmed_line, window, cx);
+                }
+            }
+        })
+        .into_any_element()
+}
