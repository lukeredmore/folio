+                                        line_bounds.left() + line_bounds.size.width,
+                                        line_bounds.bottom() - lh,
+                                    ),
+                                    lh,
+                                )
+                            })
+                        })
+                    })
+                    .unwrap_or_else(|| {
+                        let lh = self
+                            .style
+                            .base_text_style
+                            .line_height_in_pixels(window.rem_size());
