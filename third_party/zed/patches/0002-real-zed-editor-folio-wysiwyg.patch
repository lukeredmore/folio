+
+fn paint_gpui_math_descriptor(
+    descriptor: &GpuiMathCanvasDescriptor,
+    bounds: Bounds<Pixels>,
+    color: Hsla,
+    window: &mut Window,
+    cx: &mut App,
+) {
+    let origin_x = bounds.origin.x + px(2.0);
+    let baseline_y = bounds.origin.y + px(descriptor.ascent);
+
+    for primitive in &descriptor.primitives {
+        match primitive {
+            GpuiMathPrimitive::ShapedGlyphRun {
+                text,
+                origin_x: prim_x,
+                baseline_y: prim_y,
+                font_size,
+                italic,
+                bold,
+                serif,
+            } => {
+                if text.is_empty() {
+                    continue;
+                }
+                let family: SharedString = if *serif {
+                    "Times New Roman".into()
+                } else {
+                    ".SystemUIFont".into()
+                };
+                let font = Font {
+                    family,
+                    features: FontFeatures::default(),
+                    fallbacks: None,
+                    weight: if *bold {
+                        FontWeight::BOLD
+                    } else {
+                        FontWeight::NORMAL
+                    },
+                    style: if *italic {
+                        FontStyle::Italic
+                    } else {
+                        FontStyle::Normal
+                    },
+                };
+                let run = TextRun {
+                    len: text.len(),
+                    font,
+                    color,
+                    background_color: None,
+                    underline: None,
+                    strikethrough: None,
+                };
+                let shaped = window.text_system().shape_line(
+                    SharedString::from(text.clone()),
+                    px(*font_size),
+                    &[run],
+                    None,
+                );
+                let top_left = point(origin_x + px(*prim_x), baseline_y + px(*prim_y));
+                let _ = shaped.paint(
+                    top_left,
+                    px(*font_size * 1.15),
+                    TextAlign::Left,
+                    None,
+                    window,
+                    cx,
+                );
+            }
+            GpuiMathPrimitive::RuleQuad {
+                x,
+                y,
+                width,
+                height,
+            } => {
+                let quad_bounds = Bounds {
+                    origin: point(origin_x + px(*x), baseline_y + px(*y)),
+                    size: size(px(*width), px((*height).max(1.0))),
+                };
+                window.paint_quad(fill(quad_bounds, color));
+            }
+            GpuiMathPrimitive::RadicalStroke {
+                x,
+                top_y,
+                bottom_y,
+                hook_width,
+                radicand_width,
+                line_width,
+            } => {
+                let stroke = (*line_width).max(1.0);
+                // Top horizontal vinculum bar over the radicand
+                let vinculum_bounds = Bounds {
+                    origin: point(
+                        origin_x + px(*x + *hook_width * 0.65),
+                        baseline_y + px(*top_y),
+                    ),
+                    size: size(px(*radicand_width + *hook_width * 0.35 + 2.0), px(stroke)),
+                };
+                window.paint_quad(fill(vinculum_bounds, color));
+
+                // Radical glyph on the left
+                let rad_height = (*bottom_y - *top_y).abs().max(12.0);
+                let font = Font {
+                    family: "Times New Roman".into(),
+                    features: FontFeatures::default(),
+                    fallbacks: None,
+                    weight: FontWeight::NORMAL,
+                    style: FontStyle::Normal,
+                };
+                let text = SharedString::from("√");
+                let run = TextRun {
+                    len: text.len(),
+                    font,
+                    color,
+                    background_color: None,
+                    underline: None,
+                    strikethrough: None,
+                };
+                let shaped = window.text_system().shape_line(
+                    text,
+                    px(rad_height * 0.92),
+                    &[run],
+                    None,
+                );
+                let _ = shaped.paint(
+                    point(origin_x + px(*x), baseline_y + px(*top_y)),
+                    px(rad_height),
+                    TextAlign::Left,
+                    None,
+                    window,
+                    cx,
+                );
+            }
+        }
+    }
+}
