+fn is_range_on_active_line(active_line_range: &Option<Range<usize>>, range: &Range<usize>) -> bool {
+    let Some(active) = active_line_range else {
+        return false;
+    };
+    if active.start == active.end {
+        range.start <= active.start && range.end >= active.start
+    } else {
+        range.start < active.end && range.end > active.start
+    }
+}
+
+fn surrounding_code_span_delimiters(
+    source: &str,
+    content_range: &Range<usize>,
+) -> Option<(Range<usize>, Range<usize>)> {
+    let bytes = source.as_bytes();
+    if content_range.start > bytes.len() || content_range.end > bytes.len() {
+        return None;
+    }
+    let mut open_start = content_range.start;
+    if open_start > 0
+        && content_range.end < bytes.len()
+        && bytes[open_start - 1] == b' '
+        && bytes[content_range.end] == b' '
+        && open_start >= 2
+        && bytes[open_start - 2] == b'`'
+    {
+        open_start -= 1;
+    }
+    while open_start > 0 && bytes[open_start - 1] == b'`' {
+        open_start -= 1;
+    }
+    if open_start == content_range.start {
+        return None;
+    }
+    let mut close_end = content_range.end;
+    if close_end < bytes.len()
+        && bytes[close_end] == b' '
+        && close_end + 1 < bytes.len()
+        && bytes[close_end + 1] == b'`'
+    {
+        close_end += 1;
+    }
+    let ticks_start = close_end;
+    while close_end < bytes.len() && bytes[close_end] == b'`' {
+        close_end += 1;
+    }
+    if close_end == ticks_start {
+        return None;
+    }
+    Some((open_start..content_range.start, content_range.end..close_end))
+}
+
+fn toggle_inline_delimiter(
+    source: &str,
+    sel_start: usize,
+    sel_end: usize,
+    delim: &str,
+) -> (Range<usize>, String, Range<usize>) {
+    let dlen = delim.len();
+    let was_collapsed = sel_start == sel_end;
+    let sel_start = snap_char_boundary_left(source, sel_start);
+    let sel_end = if was_collapsed {
+        sel_start
+    } else {
+        snap_char_boundary_right(source, sel_end).max(sel_start)
+    };
+    let (target_start, target_end) = if sel_start < sel_end {
+        (sel_start, sel_end)
+    } else if let Some((ws, we)) = word_range_at(source, sel_start) {
+        (ws, we)
+    } else {
+        (sel_start, sel_end)
+    };
+
+    let can_strip_surrounding = if target_start >= dlen
+        && target_end + dlen <= source.len()
+        && source.get((target_start - dlen)..target_start) == Some(delim)
+        && source.get(target_end..(target_end + dlen)) == Some(delim)
+    {
+        if dlen == 1 {
+            let ch = delim.as_bytes()[0];
+            let before_count = source.as_bytes()[..target_start]
+                .iter()
+                .rev()
+                .take_while(|&&b| b == ch)
+                .count();
+            let after_count = source.as_bytes()[target_end..]
+                .iter()
+                .take_while(|&&b| b == ch)
+                .count();
+            // If surrounded by exactly `**` (bold), pressing Cmd+I (`*`) should wrap to `***`
+            // rather than corrupting `**bold**` into `*bold*`.
+            !(before_count == 2 && after_count == 2)
+        } else {
+            true
+        }
+    } else {
+        false
+    };
+
+    if can_strip_surrounding {
+        let inner = source
+            .get(target_start..target_end)
+            .unwrap_or("")
+            .to_string();
+        let new_start = target_start - dlen;
+        let new_end = new_start + inner.len();
+        return (
+            (target_start - dlen)..(target_end + dlen),
+            inner,
+            if sel_start < sel_end {
+                new_start..new_end
+            } else {
+                let offset = sel_start.saturating_sub(dlen);
+                offset..offset
+            },
+        );
+    }
+
+    let selected = source.get(target_start..target_end).unwrap_or("");
+    if selected.starts_with(delim)
+        && selected.ends_with(delim)
+        && selected.len() >= dlen * 2
+        && (dlen != 1
+            || !selected.starts_with(&format!("{delim}{delim}"))
+            || selected.starts_with(&format!("{delim}{delim}{delim}")))
+    {
+        let inner = selected[dlen..selected.len() - dlen].to_string();
+        let new_end = target_start + inner.len();
+        return (
+            target_start..target_end,
+            inner,
+            if sel_start < sel_end {
+                target_start..new_end
+            } else {
+                let offset = sel_start.saturating_sub(dlen).clamp(target_start, new_end);
+                offset..offset
+            },
+        );
+    }
+
+    let replacement = format!("{delim}{selected}{delim}");
+    let new_sel = if sel_start < sel_end {
+        (target_start + dlen)..(target_end + dlen)
+    } else if target_start < target_end {
+        let offset = sel_start + dlen;
+        offset..offset
+    } else {
+        (target_start + dlen)..(target_start + dlen)
+    };
+    (target_start..target_end, replacement, new_sel)
+}
+
+fn toggle_heading_level(
+    source: &str,
+    cursor: usize,
+    level: usize,
+) -> (Range<usize>, String, Range<usize>) {
+    let len = source.len();
+    let cursor = snap_char_boundary_left(source, cursor);
+    let line_start = source[..cursor].rfind('\n').map(|idx| idx + 1).unwrap_or(0);
+    let line_end = source[cursor..]
+        .find('\n')
+        .map(|rel| cursor + rel)
+        .unwrap_or(len);
+    let line = &source[line_start..line_end];
+    let existing_hashes = line.bytes().take_while(|&b| b == b'#').count();
+    let existing_ws = if existing_hashes > 0 {
+        line[existing_hashes..]
+            .bytes()
+            .take_while(|&b| b == b' ' || b == b'\t')
+            .count()
+    } else {
+        0
+    };
+    let old_prefix_len = if existing_hashes > 0 && existing_ws > 0 {
+        existing_hashes + existing_ws
+    } else {
+        0
+    };
+    let new_prefix = if existing_hashes == level && old_prefix_len > 0 {
+        String::new()
+    } else {
+        format!("{} ", "#".repeat(level))
+    };
+    let new_prefix_len = new_prefix.len();
+    let new_cursor = if cursor <= line_start + old_prefix_len {
+        line_start + new_prefix_len
+    } else {
+        (cursor + new_prefix_len).saturating_sub(old_prefix_len)
+    };
+    (
+        line_start..(line_start + old_prefix_len),
+        new_prefix,
+        new_cursor..new_cursor,
+    )
+}
+
+fn word_range_at(source: &str, offset: usize) -> Option<(usize, usize)> {
+    if source.is_empty() || offset > source.len() {
+        return None;
+    }
+    let offset = snap_char_boundary_left(source, offset);
+    let is_word_char = |c: char| c.is_alphanumeric() || c == '_';
+    let before = source[..offset].chars().next_back();
+    let after = source[offset..].chars().next();
+    if !before.is_some_and(is_word_char) && !after.is_some_and(is_word_char) {
+        return None;
+    }
+    let mut start = offset;
+    for (idx, ch) in source[..offset].char_indices().rev() {
+        if is_word_char(ch) {
+            start = idx;
+        } else {
+            break;
+        }
+    }
+    let mut end = offset;
+    for (rel_idx, ch) in source[offset..].char_indices() {
+        if is_word_char(ch) {
+            end = offset + rel_idx + ch.len_utf8();
+        } else {
+            break;
+        }
+    }
+    (start < end).then_some((start, end))
+}
+
+fn prev_word_boundary(source: &str, cursor: usize) -> usize {
+    let cursor = snap_char_boundary_left(source, cursor);
+    if cursor == 0 {
+        return 0;
+    }
+    let is_word = |c: char| c.is_alphanumeric() || c == '_';
+    let mut idx = cursor;
+    for (pos, ch) in source[..cursor].char_indices().rev() {
+        if ch == '\n' {
+            return if idx == cursor { pos } else { idx };
+        }
+        if !ch.is_whitespace() {
+            idx = pos + ch.len_utf8();
+            break;
+        }
+        idx = pos;
+    }
+    let prev_ch = source[..idx].chars().next_back();
+    let target_is_word = prev_ch.is_some_and(is_word);
+    for (pos, ch) in source[..idx].char_indices().rev() {
+        if ch.is_whitespace() || is_word(ch) != target_is_word {
+            return pos + ch.len_utf8();
+        }
+    }
+    0
+}
+
+fn next_word_boundary(source: &str, cursor: usize) -> usize {
+    let len = source.len();
+    let cursor = snap_char_boundary_left(source, cursor);
+    if cursor >= len {
+        return len;
+    }
+    let is_word = |c: char| c.is_alphanumeric() || c == '_';
+    let mut idx = cursor;
+    for (rel, ch) in source[cursor..].char_indices() {
+        let pos = cursor + rel;
+        if ch == '\n' {
+            return if idx == cursor { pos + 1 } else { pos };
+        }
+        if !ch.is_whitespace() {
+            idx = pos;
+            break;
+        }
+        idx = pos + ch.len_utf8();
+    }
+    if idx >= len {
+        return len;
+    }
+    let first_ch = source[idx..].chars().next();
+    let target_is_word = first_ch.is_some_and(is_word);
+    for (rel, ch) in source[idx..].char_indices() {
+        let pos = idx + rel;
+        if ch.is_whitespace() || is_word(ch) != target_is_word {
+            return pos;
+        }
+    }
+    len
+}
+
+pub(crate) fn decode_data_url_image(dest_url: &str) -> Option<Arc<Image>> {
+    let rest = dest_url.strip_prefix("data:")?;
+    if let Some((mime, b64)) = rest.split_once(";base64,") {
+        let format = ImageFormat::from_mime_type(mime)?;
+        let bytes = base64::engine::general_purpose::STANDARD
+            .decode(b64.trim())
+            .ok()?;
+        return Some(Arc::new(Image::from_bytes(format, bytes)));
+    }
+    if let Some((mime_part, raw_payload)) = rest.split_once(',') {
+        let mime = mime_part.split(';').next().unwrap_or(mime_part).trim();
+        if mime.eq_ignore_ascii_case("image/svg+xml") {
+            let decoded = percent_decode_str(raw_payload);
+            let normalized = folio_dylib::normalize_svg_markup(&decoded)
+                .map(|(svg, _, _)| svg)
+                .unwrap_or(decoded);
+            return Some(Arc::new(Image::from_bytes(
+                ImageFormat::Svg,
+                normalized.into_bytes(),
+            )));
+        }
+    }
+    None
+}
+
+fn percent_decode_str(input: &str) -> String {
+    let bytes = input.as_bytes();
+    let mut out = Vec::with_capacity(bytes.len());
+    let mut i = 0;
+    while i < bytes.len() {
+        if bytes[i] == b'%' && i + 2 < bytes.len() {
+            if let (Some(hi), Some(lo)) = (
+                (bytes[i + 1] as char).to_digit(16),
+                (bytes[i + 2] as char).to_digit(16),
+            ) {
+                out.push(((hi << 4) | lo) as u8);
+                i += 3;
+                continue;
+            }
+        }
+        out.push(bytes[i]);
+        i += 1;
+    }
+    String::from_utf8(out).unwrap_or_else(|_| input.to_string())
+}
+
+enum InlineHtmlTagAction {
+    Open(TextStyleRefinement),
+    Close,
+    StructuralHide,
+}
+
+fn classify_inline_html_tag(
+    lower: &str,
+    markdown_style: &MarkdownStyle,
+    cx: &App,
+) -> Option<InlineHtmlTagAction> {
+    let tag_inner = lower.strip_prefix('<')?.strip_suffix('>')?.trim();
+    if let Some(closing) = tag_inner.strip_prefix('/') {
+        let name = closing.split_whitespace().next()?;
+        return match name {
+            "code" | "kbd" | "u" | "ins" | "b" | "strong" | "i" | "em" | "s" | "del"
+            | "strike" | "mark" | "sup" | "sub" | "summary" => Some(InlineHtmlTagAction::Close),
+            "span" | "details" => Some(InlineHtmlTagAction::StructuralHide),
+            _ => None,
+        };
+    }
+    if tag_inner.ends_with('/') {
+        return None;
+    }
+    let name = tag_inner.split(|c: char| c.is_whitespace() || c == '/').next()?;
+    let colors = cx.theme().colors();
+    match name {
+        "code" => Some(InlineHtmlTagAction::Open(markdown_style.inline_code.clone())),
+        "kbd" => {
+            let mut style = markdown_style.inline_code.clone();
+            style.font_weight = Some(FontWeight::MEDIUM);
+            style.background_color = Some(colors.surface_background);
+            style.underline = Some(gpui::UnderlineStyle {
+                thickness: px(1.),
+                color: Some(colors.border),
+                wavy: false,
+            });
+            Some(InlineHtmlTagAction::Open(style))
+        }
+        "u" | "ins" => Some(InlineHtmlTagAction::Open(TextStyleRefinement {
+            underline: Some(gpui::UnderlineStyle {
+                thickness: px(1.),
+                color: None,
+                wavy: false,
+            }),
+            ..Default::default()
+        })),
+        "b" | "strong" | "summary" => Some(InlineHtmlTagAction::Open(TextStyleRefinement {
+            font_weight: Some(FontWeight::BOLD),
+            ..Default::default()
+        })),
+        "i" | "em" => Some(InlineHtmlTagAction::Open(TextStyleRefinement {
+            font_style: Some(FontStyle::Italic),
+            ..Default::default()
+        })),
+        "s" | "del" | "strike" => Some(InlineHtmlTagAction::Open(TextStyleRefinement {
+            strikethrough: Some(gpui::StrikethroughStyle {
+                thickness: px(1.),
+                color: None,
+            }),
+            ..Default::default()
+        })),
+        "mark" => Some(InlineHtmlTagAction::Open(TextStyleRefinement {
+            background_color: Some(gpui::hsla(0.13, 0.90, 0.55, 0.30)),
+            ..Default::default()
+        })),
+        "sup" | "sub" => Some(InlineHtmlTagAction::Open(TextStyleRefinement {
+            color: Some(colors.text_accent),
+            ..Default::default()
+        })),
+        "span" | "details" => Some(InlineHtmlTagAction::StructuralHide),
+        _ => None,
+    }
+}
+
+fn extract_html_attr(tag: &str, attr_name: &str) -> Option<String> {
+    let lower = tag.to_ascii_lowercase();
+    let needle = format!("{attr_name}=");
+    let start_idx = lower.find(&needle)?;
+    let after = &tag[start_idx + needle.len()..].trim_start();
+    if let Some(quoted) = after.strip_prefix('"') {
+        let end = quoted.find('"')?;
+        Some(quoted[..end].to_string())
+    } else if let Some(quoted) = after.strip_prefix('\'') {
+        let end = quoted.find('\'')?;
+        Some(quoted[..end].to_string())
+    } else {
+        let end = after
+            .find(|c: char| c.is_whitespace() || c == '>' || c == '/')
+            .unwrap_or(after.len());
+        (end > 0).then(|| after[..end].to_string())
+    }
+}
+
+fn parse_html_dimension_attr(val: &str) -> Option<DefiniteLength> {
+    let trimmed = val.trim();
+    if let Some(pct) = trimmed.strip_suffix('%') {
+        let v: f32 = pct.trim().parse().ok()?;
+        return Some(relative(v / 100.0));
+    }
+    let px_str = trimmed.strip_suffix("px").unwrap_or(trimmed).trim();
+    let v: f32 = px_str.parse().ok()?;
+    (v > 0.0).then(|| px(v).into())
+}
+
+fn parse_inline_html_img_tag(
+    tag: &str,
+) -> Option<(String, String, Option<DefiniteLength>, Option<DefiniteLength>)> {
+    let src = extract_html_attr(tag, "src")?;
+    let alt = extract_html_attr(tag, "alt").unwrap_or_default();
+    let width = extract_html_attr(tag, "width").and_then(|w| parse_html_dimension_attr(&w));
+    let height = extract_html_attr(tag, "height").and_then(|h| parse_html_dimension_attr(&h));
+    Some((src, alt, width, height))
+}
+
+fn handle_editable_markdown_keystroke(
+    keystroke: &gpui::Keystroke,
+    markdown: &Entity<Markdown>,
+    on_source_edit: &SourceEditCallback,
+    window: &mut Window,
+    cx: &mut App,
+) -> bool {
+    let key = keystroke.key.as_str();
+    let modifiers = &keystroke.modifiers;
+
+    let (source, selection, head, tail) = {
+        let md = markdown.read(cx);
+        (
+            md.source().clone(),
+            md.selection_range(),
+            md.selection.head(),
+            md.selection.tail(),
+        )
+    };
+    let len = source.len();
+    let sel_start = snap_char_boundary_left(&source, selection.start);
+    let sel_end = if selection.start == selection.end {
+        sel_start
+    } else {
+        snap_char_boundary_right(&source, selection.end).max(sel_start)
+    };
+    let cursor = snap_char_boundary_left(&source, head);
+    let tail = snap_char_boundary_left(&source, tail);
+
+    folio_debug_log(&format!(
+        "keystroke key={key:?} platform={} ctrl={} alt={} shift={} sel={sel_start}..{sel_end} cursor={cursor} len={len}",
+        modifiers.platform, modifiers.control, modifiers.alt, modifiers.shift
+    ));
+
+    // Formatting & selection shortcuts with platform modifier (Cmd on macOS, Ctrl elsewhere)
+    if modifiers.platform || modifiers.control {
+        match key {
+            "\\" if !modifiers.alt && modifiers.shift => {
+                window.prevent_default();
+                cx.stop_propagation();
+                markdown.update(cx, |md, cx| {
+                    md.toggle_pretty_mode(cx);
+                });
+                return true;
+            }
+            "b" if !modifiers.alt && !modifiers.shift => {
+                window.prevent_default();
+                cx.stop_propagation();
+                let (edit_range, replacement, post_selection) =
+                    toggle_inline_delimiter(&source, sel_start, sel_end, "**");
+                on_source_edit(edit_range, &replacement, window, cx);
+                markdown.update(cx, |md, cx| {
+                    md.set_selection_range(post_selection, cx);
+                });
+                return true;
+            }
+            "i" if !modifiers.alt && !modifiers.shift => {
+                window.prevent_default();
+                cx.stop_propagation();
+                let (edit_range, replacement, post_selection) =
+                    toggle_inline_delimiter(&source, sel_start, sel_end, "*");
+                on_source_edit(edit_range, &replacement, window, cx);
+                markdown.update(cx, |md, cx| {
+                    md.set_selection_range(post_selection, cx);
+                });
+                return true;
+            }
+            "e" | "`" if !modifiers.alt && !modifiers.shift => {
+                window.prevent_default();
+                cx.stop_propagation();
+                let (edit_range, replacement, post_selection) =
+                    toggle_inline_delimiter(&source, sel_start, sel_end, "`");
+                on_source_edit(edit_range, &replacement, window, cx);
+                markdown.update(cx, |md, cx| {
+                    md.set_selection_range(post_selection, cx);
+                });
+                return true;
+            }
+            "x" if !modifiers.alt && modifiers.shift => {
+                window.prevent_default();
+                cx.stop_propagation();
+                let (edit_range, replacement, post_selection) =
+                    toggle_inline_delimiter(&source, sel_start, sel_end, "~~");
+                on_source_edit(edit_range, &replacement, window, cx);
+                markdown.update(cx, |md, cx| {
+                    md.set_selection_range(post_selection, cx);
+                });
+                return true;
+            }
+            "d" if !modifiers.alt && !modifiers.shift => {
+                window.prevent_default();
+                cx.stop_propagation();
+                let (edit_range, replacement, post_selection) =
+                    toggle_inline_delimiter(&source, sel_start, sel_end, "~~");
+                on_source_edit(edit_range, &replacement, window, cx);
+                markdown.update(cx, |md, cx| {
+                    md.set_selection_range(post_selection, cx);
+                });
+                return true;
+            }
+            "m" if !modifiers.alt => {
+                window.prevent_default();
+                cx.stop_propagation();
+                let delim = if modifiers.shift { "$$" } else { "$" };
+                let (edit_range, replacement, post_selection) =
+                    toggle_inline_delimiter(&source, sel_start, sel_end, delim);
+                on_source_edit(edit_range, &replacement, window, cx);
+                markdown.update(cx, |md, cx| {
+                    md.set_selection_range(post_selection, cx);
+                });
+                return true;
+            }
+            "k" if !modifiers.alt && !modifiers.shift => {
+                window.prevent_default();
+                cx.stop_propagation();
+                let (target_start, target_end) = if sel_start < sel_end {
+                    (sel_start, sel_end)
+                } else if let Some((ws, we)) = word_range_at(&source, sel_start) {
+                    (ws, we)
+                } else {
+                    (sel_start, sel_end)
+                };
+                let selected = &source[target_start..target_end];
+                let replacement = format!("[{selected}]()");
+                let url_cursor = target_start + 1 + selected.len() + 2;
+                on_source_edit(target_start..target_end, &replacement, window, cx);
+                markdown.update(cx, |md, cx| {
+                    md.set_selection_range(url_cursor..url_cursor, cx);
+                });
+                return true;
+            }
+            "1" | "2" | "3" | "4" | "5" | "6" if !modifiers.alt && !modifiers.shift => {
+                window.prevent_default();
+                cx.stop_propagation();
+                let level = (key.as_bytes()[0] - b'0') as usize;
+                let (edit_range, replacement, post_selection) =
+                    toggle_heading_level(&source, cursor, level);
+                on_source_edit(edit_range, &replacement, window, cx);
+                markdown.update(cx, |md, cx| {
+                    md.set_selection_range(post_selection, cx);
+                });
+                return true;
+            }
+            "a" if !modifiers.alt && !modifiers.shift => {
+                window.prevent_default();
+                cx.stop_propagation();
+                markdown.update(cx, |md, cx| {
+                    md.set_selection_range(0..len, cx);
+                });
+                return true;
+            }
+            "x" if !modifiers.alt && !modifiers.shift => {
+                window.prevent_default();
+                cx.stop_propagation();
+                if sel_start < sel_end {
+                    cx.write_to_clipboard(ClipboardItem::new_string(
+                        source[sel_start..sel_end].to_string(),
+                    ));
+                    on_source_edit(sel_start..sel_end, "", window, cx);
+                }
+                return true;
+            }
+            "v" if !modifiers.alt && !modifiers.shift => {
+                window.prevent_default();
+                cx.stop_propagation();
+                if let Some(text) = cx.read_from_clipboard().and_then(|item| item.text()) {
+                    on_source_edit(sel_start..sel_end, &text, window, cx);
+                }
