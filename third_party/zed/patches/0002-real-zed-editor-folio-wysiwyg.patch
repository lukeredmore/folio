+fn render_scaled_heading_element(
+    level: usize,
+    title: String,
+    fg: Hsla,
+    underline_color: Hsla,
+) -> AnyElement {
+    let (font_size, weight, show_underline) = match level {
+        1 => (28.0, FontWeight::BOLD, true),
+        2 => (22.5, FontWeight::BOLD, true),
+        3 => (19.0, FontWeight::SEMIBOLD, false),
+        4 => (17.0, FontWeight::SEMIBOLD, false),
+        5 => (16.0, FontWeight::SEMIBOLD, false),
+        _ => (14.5, FontWeight::SEMIBOLD, false),
+    };
+
+    let mut container = div()
+        .flex()
+        .items_center()
+        .text_size(px(font_size))
+        .font_weight(weight)
+        .text_color(fg)
+        .child(SharedString::from(title));
+
+    if show_underline {
+        container = container
+            .min_w(px(520.0))
+            .pb(px(2.0))
+            .border_b_1()
+            .border_color(underline_color);
+    }
+
+    container.into_any_element()
+}
