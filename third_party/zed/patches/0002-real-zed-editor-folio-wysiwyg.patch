diff --git a/crates/editor/src/folio_wysiwyg.rs b/crates/editor/src/folio_wysiwyg.rs
new file mode 100644
index 0000000..de3d09a
--- /dev/null
+++ b/crates/editor/src/folio_wysiwyg.rs
@@ -0,0 +1,1642 @@
+use std::{any::TypeId, ops::Range, sync::Arc};
+
+use collections::HashSet;
+use gpui::{
+    AnyElement, App, Bounds, Context, Empty, Font, FontFeatures, FontStyle, FontWeight,
+    HighlightStyle, Hsla, InteractiveElement as _, IntoElement as _, MouseButton,
+    ParentElement as _, Pixels, Rgba, SharedString, StrikethroughStyle, Styled as _, TextAlign,
+    TextRun, UnderlineStyle, Window, canvas, div, fill, point, px, size,
+};
+use multi_buffer::{Anchor, MultiBufferOffset, MultiBufferRow, ToOffset as _, ToPoint as _};
+use folio_engine::{
+    MarkdownBlockDecorationKind, SyntaxTokenKind, analyze_markdown_document, language_accent_color,
+};
+use folio_zed_mod::{GpuiMathCanvasDescriptor, GpuiMathPrimitive, build_gpui_math_canvas};
+use theme::ActiveTheme as _;
+
+use crate::{
+    BlockPlacement, BlockProperties, BlockStyle, CustomBlockId, Editor, FoldPlaceholder,
+    HighlightKey, RowHighlightOptions, display_map::Crease,
+};
+
+struct FolioMarkdownFoldTag;
+struct FolioMarkdownCodeBlockRowHighlight;
+
+#[derive(Clone, PartialEq, Eq)]
+pub(crate) struct FolioMarkdownCacheKey {
+    text_len: usize,
+    active_row: u32,
+    selected_rows: Vec<(u32, u32)>,
+    is_dark: bool,
+}
+
+#[derive(Default)]
+pub(crate) struct FolioMarkdownState {
+    pub(crate) custom_blocks: HashSet<CustomBlockId>,
+    pub(crate) last_key: Option<FolioMarkdownCacheKey>,
+    pub(crate) was_markdown: bool,
+}
+
+#[derive(Clone)]
+struct ParsedTableRow {
+    row: u32,
+    is_header: bool,
+    is_separator: bool,
+    columns: Vec<String>,
+}
+
+enum ParsedListLine {
+    Task {
+        indent_spaces: usize,
+        fold_byte_range: Range<usize>,
+        bracket_byte_range: Range<usize>,
+        content_byte_range: Range<usize>,
+        checked: bool,
+    },
+    Unordered {
+        indent_spaces: usize,
+        fold_byte_range: Range<usize>,
+    },
+    Ordered {
+        marker_byte_range: Range<usize>,
+    },
+}
+
+impl Editor {
+    pub(crate) fn invalidate_folio_markdown_wysiwyg(&mut self) {
+        self.folio_markdown_state.last_key = None;
+    }
+
+    pub(crate) fn refresh_folio_markdown_wysiwyg(&mut self, cx: &mut Context<Self>) {
+        if !self.mode.is_full() {
+            return;
+        }
+
+        if !self.is_in_markdown_language(cx) {
+            if self.folio_markdown_state.was_markdown {
+                self.clear_folio_markdown_wysiwyg(cx);
+                self.folio_markdown_state.was_markdown = false;
+            }
+            return;
+        }
+
+        let snapshot = self.buffer.read(cx).snapshot(cx);
+        let newest_selection = self.selections.newest_anchor().clone();
+        let head_anchor = newest_selection.head();
+        let head_point = head_anchor.to_point(&snapshot);
+        let head_offset = head_anchor.to_offset(&snapshot).0;
+        let is_dark = !cx.theme().appearance.is_light();
+
+        let selected_rows: Vec<(u32, u32)> = self
+            .selections
+            .disjoint_anchors_arc()
+            .iter()
+            .map(|sel| {
+                let start_row = sel.start.to_point(&snapshot).row;
+                let end_row = sel.end.to_point(&snapshot).row;
+                (start_row.min(end_row), start_row.max(end_row))
+            })
+            .collect();
+
+        let cache_key = FolioMarkdownCacheKey {
+            text_len: snapshot.len().0,
+            active_row: head_point.row,
+            selected_rows: selected_rows.clone(),
+            is_dark,
+        };
+
+        if self.folio_markdown_state.was_markdown
+            && self.folio_markdown_state.last_key.as_ref() == Some(&cache_key)
+        {
+            return;
+        }
+
+        self.folio_markdown_state.was_markdown = true;
+        self.folio_markdown_state.last_key = Some(cache_key);
+
+        let text = snapshot.text();
+        let analysis = analyze_markdown_document(&text, head_offset, false, false);
+
+        let is_row_selected = |row: u32| -> bool {
+            row == head_point.row
+                || selected_rows
+                    .iter()
+                    .any(|&(sel_start, sel_end)| row >= sel_start && row <= sel_end)
+        };
+
+        let is_range_on_selected_row = |byte_range: &Range<usize>| -> bool {
+            let start_row = snapshot
+                .offset_to_point(MultiBufferOffset(byte_range.start.min(text.len())))
+                .row;
+            let end_row = snapshot
+                .offset_to_point(MultiBufferOffset(byte_range.end.min(text.len())))
+                .row;
+            (start_row..=end_row).any(&is_row_selected)
+        };
+
+        // 1. Clear previous Folio folds, custom blocks, row highlights, and text highlights
+        self.display_map.update(cx, |display_map, cx| {
+            display_map.remove_folds_with_type(
+                [Anchor::Min..Anchor::Max],
+                TypeId::of::<FolioMarkdownFoldTag>(),
+                cx,
+            );
+        });
+        if !self.folio_markdown_state.custom_blocks.is_empty() {
+            let prev_blocks = std::mem::take(&mut self.folio_markdown_state.custom_blocks);
+            self.remove_blocks(prev_blocks, None, cx);
+        }
+        self.clear_row_highlights::<FolioMarkdownCodeBlockRowHighlight>();
+        self.clear_highlights_with(
+            &mut |key| matches!(key, HighlightKey::FolioMarkdown(_)),
+            cx,
+        );
+
+        let colors = cx.theme().colors();
+        let text_color = colors.editor_foreground;
+        let muted_color = colors.text_muted;
+        let accent_color = colors.text_accent;
+        let border_color = colors.border;
+        let surface_bg = colors.surface_background;
+        let elevated_bg = colors.elevated_surface_background;
+
+        let mut creases: Vec<Crease<Anchor>> = Vec::new();
+        let mut new_blocks: Vec<BlockProperties<Anchor>> = Vec::new();
+        let mut folded_full_rows: HashSet<u32> = HashSet::default();
+        let mut code_or_math_rows: HashSet<u32> = HashSet::default();
+
+        // 2. Scaled WYSIWYG Headings (# H1 .. ###### H6)
+        let mut active_heading_ranges = Vec::new();
+        for heading in &analysis.headings {
+            let row = (heading.line_number.saturating_sub(1)) as u32;
+            let row_len = snapshot.line_len(MultiBufferRow(row));
+            if row_len == 0 {
+                continue;
+            }
+            if !is_row_selected(row) {
+                folded_full_rows.insert(row);
+                let row_start = snapshot.anchor_after(text::Point::new(row, 0));
+                let row_end = snapshot.anchor_before(text::Point::new(row, row_len));
+                let level = heading.level;
+                let clean_title = clean_inline_markdown(&heading.title);
+                let fg = if level == 6 { muted_color } else { text_color };
+                let underline_color = border_color;
+                creases.push(Crease::simple(
+                    row_start..row_end,
+                    FoldPlaceholder {
+                        render: Arc::new(move |_, _, _| {
+                            render_scaled_heading_element(
+                                level,
+                                clean_title.clone(),
+                                fg,
+                                underline_color,
+                            )
+                        }),
+                        constrain_width: false,
+                        merge_adjacent: false,
+                        type_tag: Some(TypeId::of::<FolioMarkdownFoldTag>()),
+                        collapsed_text: None,
+                    },
+                ));
+            } else {
+                let start = snapshot.anchor_before(text::Point::new(row, 0));
+                let end = snapshot.anchor_after(text::Point::new(row, row_len));
+                active_heading_ranges.push(start..end);
+            }
+        }
+
+        // 3. Block decorations: Math, Code Fences, Tables, Blockquotes, Inline Code
+        let mut single_line_math_ranges: Vec<Range<usize>> = Vec::new();
+        let mut multi_line_math_ranges: Vec<(Range<usize>, String, bool)> = Vec::new();
+        let mut monospace_ranges: Vec<Range<Anchor>> = Vec::new();
+        let mut code_fence_row_ranges: Vec<Range<Anchor>> = Vec::new();
+        let mut inline_code_ranges: Vec<Range<Anchor>> = Vec::new();
+        let mut blockquote_ranges: Vec<Range<Anchor>> = Vec::new();
+        let mut table_rows: Vec<ParsedTableRow> = Vec::new();
+
+        for dec in &analysis.block_decorations {
+            let start = dec.byte_range.start.min(text.len());
+            let end = dec.byte_range.end.min(text.len());
+            if start >= end {
+                continue;
+            }
+            let start_pt = snapshot.offset_to_point(MultiBufferOffset(start));
+            let end_pt = snapshot.offset_to_point(MultiBufferOffset(end.saturating_sub(1)));
+
+            match &dec.kind {
+                MarkdownBlockDecorationKind::InlineMathRendered {
+                    latex, is_active, ..
+                } => {
+                    if !folded_full_rows.contains(&start_pt.row)
+                        && !*is_active
+                        && !is_range_on_selected_row(&dec.byte_range)
+                    {
+                        let anchor_range = snapshot.anchor_after(MultiBufferOffset(start))
+                            ..snapshot.anchor_before(MultiBufferOffset(end));
+                        let descriptor = build_gpui_math_canvas(latex, 15.5, false);
+                        let fg = text_color;
+                        creases.push(Crease::simple(
+                            anchor_range,
+                            FoldPlaceholder {
+                                render: Arc::new(move |_, _, _| {
+                                    render_inline_math_element(descriptor.clone(), fg)
+                                }),
+                                constrain_width: false,
+                                merge_adjacent: false,
+                                type_tag: Some(TypeId::of::<FolioMarkdownFoldTag>()),
+                                collapsed_text: None,
+                            },
+                        ));
+                    }
+                }
+                MarkdownBlockDecorationKind::MathBlockRendered {
+                    latex, is_active, ..
+                } => {
+                    for r in start_pt.row..=end_pt.row {
+                        code_or_math_rows.insert(r);
+                    }
+                    let active_or_selected =
+                        *is_active || is_range_on_selected_row(&dec.byte_range);
+                    if start_pt.row == end_pt.row {
+                        single_line_math_ranges.push(dec.byte_range.clone());
+                        if !active_or_selected {
+                            let line_end = text[start..end]
+                                .trim_end_matches(&['\r', '\n'][..])
+                                .len()
+                                + start;
+                            if start < line_end {
+                                folded_full_rows.insert(start_pt.row);
+                                let anchor_range = snapshot.anchor_after(MultiBufferOffset(start))
+                                    ..snapshot.anchor_before(MultiBufferOffset(line_end));
+                                let descriptor = build_gpui_math_canvas(latex, 17.5, true);
+                                let fg = text_color;
+                                let card_bg = elevated_bg;
+                                let card_border = border_color;
+                                creases.push(Crease::simple(
+                                    anchor_range,
+                                    FoldPlaceholder {
+                                        render: Arc::new(move |_, _, _| {
+                                            render_display_math_inline_card(
+                                                descriptor.clone(),
+                                                fg,
+                                                card_bg,
+                                                card_border,
+                                            )
+                                        }),
+                                        constrain_width: false,
+                                        merge_adjacent: false,
+                                        type_tag: Some(TypeId::of::<FolioMarkdownFoldTag>()),
+                                        collapsed_text: None,
+                                    },
+                                ));
+                            }
+                        }
+                    } else {
+                        multi_line_math_ranges.push((
+                            dec.byte_range.clone(),
+                            latex.clone(),
+                            active_or_selected,
+                        ));
+                    }
+                }
+                MarkdownBlockDecorationKind::CodeFenceStart { language } => {
+                    let row = start_pt.row;
+                    code_or_math_rows.insert(row);
+                    let row_len = snapshot.line_len(MultiBufferRow(row));
+                    let row_start = snapshot.anchor_before(text::Point::new(row, 0));
+                    let row_end = snapshot.anchor_after(text::Point::new(row, row_len));
+                    code_fence_row_ranges.push(row_start..row_end);
+                    monospace_ranges.push(row_start..row_end);
+
+                    if !is_row_selected(row) && row_len > 0 {
+                        folded_full_rows.insert(row);
+                        let fold_start = snapshot.anchor_after(text::Point::new(row, 0));
+                        let fold_end = snapshot.anchor_before(text::Point::new(row, row_len));
+                        let lang_label = if language.trim().is_empty() {
+                            "CODE".to_string()
+                        } else {
+                            language.trim().to_ascii_uppercase()
+                        };
+                        let dot_rgba = language_accent_color(language, is_dark);
+                        let dot_color: Hsla = Rgba {
+                            r: dot_rgba.r as f32,
+                            g: dot_rgba.g as f32,
+                            b: dot_rgba.b as f32,
+                            a: dot_rgba.a as f32,
+                        }
+                        .into();
+                        let pill_bg = elevated_bg;
+                        let pill_border = border_color;
+                        let pill_fg = muted_color;
+                        creases.push(Crease::simple(
+                            fold_start..fold_end,
+                            FoldPlaceholder {
+                                render: Arc::new(move |_, _, _| {
+                                    render_code_fence_language_pill(
+                                        lang_label.clone(),
+                                        dot_color,
+                                        pill_fg,
+                                        pill_bg,
+                                        pill_border,
+                                    )
+                                }),
+                                constrain_width: false,
+                                merge_adjacent: false,
+                                type_tag: Some(TypeId::of::<FolioMarkdownFoldTag>()),
+                                collapsed_text: None,
+                            },
+                        ));
+                    }
+                }
+                MarkdownBlockDecorationKind::CodeFenceBody { .. } => {
+                    for r in start_pt.row..=end_pt.row {
+                        code_or_math_rows.insert(r);
+                    }
+                    let row_start = snapshot.anchor_before(text::Point::new(start_pt.row, 0));
+                    let row_end = snapshot.anchor_after(text::Point::new(
+                        end_pt.row,
+                        snapshot.line_len(MultiBufferRow(end_pt.row)),
+                    ));
+                    code_fence_row_ranges.push(row_start..row_end);
+                    monospace_ranges.push(row_start..row_end);
+                }
+                MarkdownBlockDecorationKind::CodeFenceEnd => {
+                    let row = start_pt.row;
+                    code_or_math_rows.insert(row);
+                    let row_len = snapshot.line_len(MultiBufferRow(row));
+                    let row_start = snapshot.anchor_before(text::Point::new(row, 0));
+                    let row_end = snapshot.anchor_after(text::Point::new(row, row_len));
+                    code_fence_row_ranges.push(row_start..row_end);
+                    monospace_ranges.push(row_start..row_end);
+
+                    if !is_row_selected(row) && row_len > 0 {
+                        folded_full_rows.insert(row);
+                        let fold_start = snapshot.anchor_after(text::Point::new(row, 0));
+                        let fold_end = snapshot.anchor_before(text::Point::new(row, row_len));
+                        let bar_color = border_color;
+                        creases.push(Crease::simple(
+                            fold_start..fold_end,
+                            FoldPlaceholder {
+                                render: Arc::new(move |_, _, _| {
+                                    div()
+                                        .flex()
+                                        .items_center()
+                                        .py(px(2.0))
+                                        .child(
+                                            div()
+                                                .w(px(64.0))
+                                                .h(px(1.0))
+                                                .rounded(px(0.5))
+                                                .bg(bar_color),
+                                        )
+                                        .into_any_element()
+                                }),
+                                constrain_width: false,
+                                merge_adjacent: false,
+                                type_tag: Some(TypeId::of::<FolioMarkdownFoldTag>()),
+                                collapsed_text: None,
+                            },
+                        ));
+                    }
+                }
+                MarkdownBlockDecorationKind::InlineCode => {
+                    if !folded_full_rows.contains(&start_pt.row) {
+                        let range = snapshot.anchor_before(MultiBufferOffset(start))
+                            ..snapshot.anchor_after(MultiBufferOffset(end));
+                        inline_code_ranges.push(range.clone());
+                        monospace_ranges.push(range);
+                    }
+                }
+                MarkdownBlockDecorationKind::Blockquote { .. } => {
+                    let row = start_pt.row;
+                    let row_len = snapshot.line_len(MultiBufferRow(row));
+                    if row_len > 0 {
+                        let row_start = snapshot.anchor_before(text::Point::new(row, 0));
+                        let row_end = snapshot.anchor_after(text::Point::new(row, row_len));
+                        blockquote_ranges.push(row_start..row_end);
+                    }
+                }
+                MarkdownBlockDecorationKind::TableRow {
+                    is_header,
+                    is_separator,
+                    columns,
+                } => {
+                    let row = start_pt.row;
+                    code_or_math_rows.insert(row);
+                    table_rows.push(ParsedTableRow {
+                        row,
+                        is_header: *is_header,
+                        is_separator: *is_separator,
+                        columns: columns.clone(),
+                    });
+                }
+                _ => {}
+            }
+        }
+
+        // Apply full-row surface background highlights for fenced code blocks
+        for range in code_fence_row_ranges {
+            self.highlight_rows::<FolioMarkdownCodeBlockRowHighlight>(
+                range,
+                |cx| cx.theme().colors().surface_background,
+                RowHighlightOptions {
+                    autoscroll: false,
+                    include_gutter: false,
+                },
+                cx,
+            );
+        }
+
+        // 4. Structured WYSIWYG Tables (group contiguous table rows to compute column widths)
+        let mut table_idx = 0;
+        while table_idx < table_rows.len() {
+            let group_start = table_idx;
+            let mut group_end = table_idx + 1;
+            while group_end < table_rows.len()
+                && table_rows[group_end].row == table_rows[group_end - 1].row + 1
+            {
+                group_end += 1;
+            }
+            let group = &table_rows[group_start..group_end];
+            let max_cols = group.iter().map(|r| r.columns.len()).max().unwrap_or(0);
+            let mut col_widths: Vec<f32> = vec![80.0; max_cols];
+            for col_i in 0..max_cols {
+                let max_chars = group
+                    .iter()
+                    .filter(|r| !r.is_separator)
+                    .filter_map(|r| r.columns.get(col_i))
+                    .map(|cell| clean_inline_markdown(cell).chars().count())
+                    .max()
+                    .unwrap_or(4);
+                col_widths[col_i] = ((max_chars.max(4) as f32) * 9.2 + 28.0).clamp(80.0, 300.0);
+            }
+
+            for trow in group {
+                let row = trow.row;
+                let row_len = snapshot.line_len(MultiBufferRow(row));
+                if row_len == 0 {
+                    continue;
+                }
+                if !is_row_selected(row) {
+                    folded_full_rows.insert(row);
+                    let fold_start = snapshot.anchor_after(text::Point::new(row, 0));
+                    let fold_end = snapshot.anchor_before(text::Point::new(row, row_len));
+                    let widths = col_widths.clone();
+                    let cols: Vec<String> = trow
+                        .columns
+                        .iter()
+                        .map(|c| clean_inline_markdown(c))
+                        .collect();
+                    let is_header = trow.is_header;
+                    let is_separator = trow.is_separator;
+                    let fg = text_color;
+                    let header_bg = surface_bg;
+                    let cell_border = border_color;
+                    creases.push(Crease::simple(
+                        fold_start..fold_end,
+                        FoldPlaceholder {
+                            render: Arc::new(move |_, _, _| {
+                                render_table_row_element(
+                                    &cols,
+                                    &widths,
+                                    is_header,
+                                    is_separator,
+                                    fg,
+                                    header_bg,
+                                    cell_border,
+                                )
+                            }),
+                            constrain_width: false,
+                            merge_adjacent: false,
+                            type_tag: Some(TypeId::of::<FolioMarkdownFoldTag>()),
+                            collapsed_text: None,
+                        },
+                    ));
+                } else {
+                    let row_start = snapshot.anchor_before(text::Point::new(row, 0));
+                    let row_end = snapshot.anchor_after(text::Point::new(row, row_len));
+                    monospace_ranges.push(row_start..row_end);
+                }
+            }
+
+            table_idx = group_end;
+        }
+
+        // 5. Multi-line display math blocks
+        for (range, latex, active_or_selected) in &multi_line_math_ranges {
+            let start = range.start.min(text.len());
+            let end = range.end.min(text.len());
+            let start_row = snapshot.offset_to_point(MultiBufferOffset(start)).row;
+            let end_row = snapshot
+                .offset_to_point(MultiBufferOffset(end.saturating_sub(1)))
+                .row;
+
+            if !*active_or_selected {
+                for row in start_row..=end_row {
+                    folded_full_rows.insert(row);
+                    let row_len = snapshot.line_len(MultiBufferRow(row));
+                    if row_len > 0 {
+                        let row_start = snapshot.anchor_after(text::Point::new(row, 0));
+                        let row_end = snapshot.anchor_before(text::Point::new(row, row_len));
+                        creases.push(Crease::simple(
+                            row_start..row_end,
+                            empty_folio_fold_placeholder(),
+                        ));
+                    }
+                }
+
+                let end_anchor = snapshot.anchor_before(text::Point::new(
+                    end_row,
+                    snapshot.line_len(MultiBufferRow(end_row)),
+                ));
+                let descriptor = build_gpui_math_canvas(latex, 18.0, true);
+                let fg = text_color;
+                let card_bg = elevated_bg;
+                let card_border = border_color;
+                let block_rows = ((descriptor.total_height() + 24.0) / 24.0)
+                    .ceil()
+                    .clamp(2.0, 6.0) as u32;
+                new_blocks.push(BlockProperties {
+                    placement: BlockPlacement::Below(end_anchor),
+                    height: Some(block_rows),
+                    style: BlockStyle::Fixed,
+                    render: Arc::new(move |_cx| {
+                        render_display_math_block_card(
+                            descriptor.clone(),
+                            fg,
+                            card_bg,
+                            card_border,
+                        )
+                    }),
+                    priority: 0,
+                });
+            } else {
+                let row_start = snapshot.anchor_before(text::Point::new(start_row, 0));
+                let row_end = snapshot.anchor_after(text::Point::new(
+                    end_row,
+                    snapshot.line_len(MultiBufferRow(end_row)),
+                ));
+                monospace_ranges.push(row_start..row_end);
+            }
+        }
+
+        // 6. Lists & Interactive Task Checklists (- [ ], - [x], - , * , + , 1. )
+        let mut checked_task_ranges: Vec<Range<Anchor>> = Vec::new();
+        let mut list_marker_ranges: Vec<Range<Anchor>> = Vec::new();
+        let weak_editor = cx.weak_entity();
+
+        let mut line_byte_start = 0usize;
+        for (line_idx, raw_line) in text.split('\n').enumerate() {
+            let row = line_idx as u32;
+            let clean_line = raw_line.trim_end_matches('\r');
+            let next_line_start = line_byte_start + raw_line.len() + 1;
+
+            if !folded_full_rows.contains(&row) && !code_or_math_rows.contains(&row) {
+                if let Some(parsed_list) = parse_list_line(clean_line, line_byte_start) {
+                    match parsed_list {
+                        ParsedListLine::Task {
+                            indent_spaces,
+                            fold_byte_range,
+                            bracket_byte_range,
+                            content_byte_range,
+                            checked,
+                        } => {
+                            if checked && content_byte_range.start < content_byte_range.end {
+                                checked_task_ranges.push(
+                                    snapshot
+                                        .anchor_before(MultiBufferOffset(content_byte_range.start))
+                                        ..snapshot.anchor_after(MultiBufferOffset(
+                                            content_byte_range.end,
+                                        )),
+                                );
+                            }
+                            if !is_row_selected(row)
+                                && fold_byte_range.start < fold_byte_range.end
+                            {
+                                let anchor_range = snapshot
+                                    .anchor_after(MultiBufferOffset(fold_byte_range.start))
+                                    ..snapshot
+                                        .anchor_before(MultiBufferOffset(fold_byte_range.end));
+                                let toggle_start =
+                                    snapshot.anchor_before(MultiBufferOffset(bracket_byte_range.start));
+                                let toggle_end =
+                                    snapshot.anchor_after(MultiBufferOffset(bracket_byte_range.end));
+                                let replacement: &'static str =
+                                    if checked { "[ ]" } else { "[x]" };
+                                let weak = weak_editor.clone();
+                                let box_accent = accent_color;
+                                let box_border = border_color;
+                                let box_bg = surface_bg;
+                                creases.push(Crease::simple(
+                                    anchor_range,
+                                    FoldPlaceholder {
+                                        render: Arc::new(move |fold_id, _, _| {
+                                            let weak = weak.clone();
+                                            let toggle_range =
+                                                toggle_start.clone()..toggle_end.clone();
+                                            render_task_checkbox_element(
+                                                fold_id.into(),
+                                                indent_spaces,
+                                                checked,
+                                                box_accent,
+                                                box_border,
+                                                box_bg,
+                                                move |window, cx| {
+                                                    let _ =
+                                                        weak.update(cx, |editor, cx| {
+                                                            editor.transact(
+                                                                window,
+                                                                cx,
+                                                                |editor, _window, cx| {
+                                                                    editor.buffer.update(
+                                                                        cx,
+                                                                        |buffer, cx| {
+                                                                            buffer.edit(
+                                                                                [(
+                                                                                    toggle_range
+                                                                                        .clone(),
+                                                                                    replacement,
+                                                                                )],
+                                                                                None,
+                                                                                cx,
+                                                                            );
+                                                                        },
+                                                                    );
+                                                                },
+                                                            );
+                                                            editor
+                                                                .invalidate_folio_markdown_wysiwyg();
+                                                            editor
+                                                                .refresh_folio_markdown_wysiwyg(cx);
+                                                            cx.notify();
+                                                        });
+                                                },
+                                            )
+                                        }),
+                                        constrain_width: false,
+                                        merge_adjacent: false,
+                                        type_tag: Some(TypeId::of::<FolioMarkdownFoldTag>()),
+                                        collapsed_text: None,
+                                    },
+                                ));
+                            } else {
+                                list_marker_ranges.push(
+                                    snapshot
+                                        .anchor_before(MultiBufferOffset(fold_byte_range.start))
+                                        ..snapshot.anchor_after(MultiBufferOffset(
+                                            fold_byte_range.end,
+                                        )),
+                                );
+                            }
+                        }
+                        ParsedListLine::Unordered {
+                            indent_spaces,
+                            fold_byte_range,
+                        } => {
+                            if !is_row_selected(row)
+                                && fold_byte_range.start < fold_byte_range.end
+                            {
+                                let anchor_range = snapshot
+                                    .anchor_after(MultiBufferOffset(fold_byte_range.start))
+                                    ..snapshot
+                                        .anchor_before(MultiBufferOffset(fold_byte_range.end));
+                                let bullet_color = accent_color;
+                                creases.push(Crease::simple(
+                                    anchor_range,
+                                    FoldPlaceholder {
+                                        render: Arc::new(move |_, _, _| {
+                                            render_unordered_bullet_element(
+                                                indent_spaces,
+                                                bullet_color,
+                                            )
+                                        }),
+                                        constrain_width: false,
+                                        merge_adjacent: false,
+                                        type_tag: Some(TypeId::of::<FolioMarkdownFoldTag>()),
+                                        collapsed_text: None,
+                                    },
+                                ));
+                            } else {
+                                list_marker_ranges.push(
+                                    snapshot
+                                        .anchor_before(MultiBufferOffset(fold_byte_range.start))
+                                        ..snapshot.anchor_after(MultiBufferOffset(
+                                            fold_byte_range.end,
+                                        )),
+                                );
+                            }
+                        }
+                        ParsedListLine::Ordered { marker_byte_range } => {
+                            if marker_byte_range.start < marker_byte_range.end {
+                                list_marker_ranges.push(
+                                    snapshot
+                                        .anchor_before(MultiBufferOffset(marker_byte_range.start))
+                                        ..snapshot.anchor_after(MultiBufferOffset(
+                                            marker_byte_range.end,
+                                        )),
+                                );
+                            }
+                        }
+                    }
+                }
+            }
+
+            line_byte_start = next_line_start;
+        }
+
+        // 7. Fold inline syntax tokens on inactive rows
+        for span in &analysis.syntax_fold_spans {
+            if span.is_revealed || is_range_on_selected_row(&span.byte_range) {
+                continue;
+            }
+            if matches!(
+                span.kind,
+                SyntaxTokenKind::InlineMathDollar
+                    | SyntaxTokenKind::MathBlockDelimiter
+                    | SyntaxTokenKind::HeadingHashes
+                    | SyntaxTokenKind::CodeFenceDelimiter
+                    | SyntaxTokenKind::TablePipeDelimiter
+                    | SyntaxTokenKind::TaskListMarker
+            ) {
+                continue;
+            }
+
+            let start = span.byte_range.start.min(text.len());
+            let end = span.byte_range.end.min(text.len());
+            if start >= end {
+                continue;
+            }
+            let start_row = snapshot.offset_to_point(MultiBufferOffset(start)).row;
+            if folded_full_rows.contains(&start_row) {
+                continue;
+            }
+
+            let anchor_range = snapshot.anchor_after(MultiBufferOffset(start))
+                ..snapshot.anchor_before(MultiBufferOffset(end));
+
+            match span.kind {
+                SyntaxTokenKind::BlockquoteMarker => {
+                    let bar_color = accent_color;
+                    creases.push(Crease::simple(
+                        anchor_range,
+                        FoldPlaceholder {
+                            render: Arc::new(move |_, _, _| {
+                                div()
+                                    .flex()
+                                    .items_center()
+                                    .pr(px(10.0))
+                                    .child(
+                                        div()
+                                            .w(px(3.5))
+                                            .h(px(20.0))
+                                            .rounded(px(1.5))
+                                            .bg(bar_color),
+                                    )
+                                    .into_any_element()
+                            }),
+                            constrain_width: false,
+                            merge_adjacent: false,
+                            type_tag: Some(TypeId::of::<FolioMarkdownFoldTag>()),
+                            collapsed_text: None,
+                        },
+                    ));
+                }
+                SyntaxTokenKind::HorizontalRule => {
+                    let rule_color = border_color;
+                    creases.push(Crease::simple(
+                        anchor_range,
+                        FoldPlaceholder {
+                            render: Arc::new(move |_, _, _| {
+                                div()
+                                    .flex()
+                                    .items_center()
+                                    .py(px(8.0))
+                                    .child(
+                                        div()
+                                            .w(px(560.0))
+                                            .h(px(1.5))
+                                            .rounded(px(1.0))
+                                            .bg(rule_color),
+                                    )
+                                    .into_any_element()
+                            }),
+                            constrain_width: false,
+                            merge_adjacent: false,
+                            type_tag: Some(TypeId::of::<FolioMarkdownFoldTag>()),
+                            collapsed_text: None,
+                        },
+                    ));
+                }
+                _ => {
+                    creases.push(Crease::simple(
+                        anchor_range,
+                        empty_folio_fold_placeholder(),
+                    ));
+                }
+            }
+        }
+
+        if !creases.is_empty() {
+            self.display_map.update(cx, |display_map, cx| {
+                display_map.fold(creases, cx);
+            });
+        }
+
+        if !new_blocks.is_empty() {
+            let block_ids = self.insert_blocks(new_blocks, None, cx);
+            self.folio_markdown_state.custom_blocks.extend(block_ids);
+        }
+
+        // 8. Apply rich inline highlights (headings, inline code, bold, italic, strikethrough, highlight, links, lists, blockquotes, monospace spans)
+        if !active_heading_ranges.is_empty() {
+            self.highlight_text(
+                HighlightKey::FolioMarkdown(0),
+                active_heading_ranges,
+                HighlightStyle {
+                    font_weight: Some(FontWeight::BOLD),
+                    color: Some(accent_color),
+                    ..Default::default()
+                },
+                cx,
+            );
+        }
+
+        if !inline_code_ranges.is_empty() {
+            self.highlight_text(
+                HighlightKey::FolioMarkdown(1),
+                inline_code_ranges,
+                HighlightStyle {
+                    background_color: Some(surface_bg),
+                    color: Some(accent_color),
+                    fade_out: Some(-1.0),
+                    ..Default::default()
+                },
+                cx,
+            );
+        }
+
+        // Pair consecutive Bold / Italic / Strikethrough / Highlight / Link markers to style their inner spans
+        let mut bold_ranges = Vec::new();
+        let mut italic_ranges = Vec::new();
+        let mut strike_ranges = Vec::new();
+        let mut highlight_ranges = Vec::new();
+        let mut link_label_ranges = Vec::new();
+
+        let mut open_bold: Option<usize> = None;
+        let mut open_italic: Option<usize> = None;
+        let mut open_strike: Option<usize> = None;
+        let mut open_highlight: Option<usize> = None;
+        let mut open_link_bracket: Option<usize> = None;
+
+        for span in &analysis.syntax_fold_spans {
+            match span.kind {
+                SyntaxTokenKind::BoldMarker => {
+                    if let Some(start) = open_bold.take() {
+                        if start < span.byte_range.start {
+                            bold_ranges.push(
+                                snapshot.anchor_before(MultiBufferOffset(start))
+                                    ..snapshot
+                                        .anchor_after(MultiBufferOffset(span.byte_range.start)),
+                            );
+                        }
+                    } else {
+                        open_bold = Some(span.byte_range.end);
+                    }
+                }
+                SyntaxTokenKind::ItalicMarker => {
+                    if let Some(start) = open_italic.take() {
+                        if start < span.byte_range.start {
+                            italic_ranges.push(
+                                snapshot.anchor_before(MultiBufferOffset(start))
+                                    ..snapshot
+                                        .anchor_after(MultiBufferOffset(span.byte_range.start)),
+                            );
+                        }
+                    } else {
+                        open_italic = Some(span.byte_range.end);
+                    }
+                }
+                SyntaxTokenKind::StrikethroughMarker => {
+                    if let Some(start) = open_strike.take() {
+                        if start < span.byte_range.start {
+                            strike_ranges.push(
+                                snapshot.anchor_before(MultiBufferOffset(start))
+                                    ..snapshot
+                                        .anchor_after(MultiBufferOffset(span.byte_range.start)),
+                            );
+                        }
+                    } else {
+                        open_strike = Some(span.byte_range.end);
+                    }
+                }
+                SyntaxTokenKind::HighlightMarker => {
+                    if let Some(start) = open_highlight.take() {
+                        if start < span.byte_range.start {
+                            highlight_ranges.push(
+                                snapshot.anchor_before(MultiBufferOffset(start))
+                                    ..snapshot
+                                        .anchor_after(MultiBufferOffset(span.byte_range.start)),
+                            );
+                        }
+                    } else {
+                        open_highlight = Some(span.byte_range.end);
+                    }
+                }
+                SyntaxTokenKind::LinkSyntax => {
+                    let slice = &text[span.byte_range.start.min(text.len())
+                        ..span.byte_range.end.min(text.len())];
+                    if slice == "[" {
+                        open_link_bracket = Some(span.byte_range.end);
+                    } else if slice.starts_with("](") {
+                        if let Some(start) = open_link_bracket.take() {
+                            if start < span.byte_range.start {
+                                link_label_ranges.push(
+                                    snapshot.anchor_before(MultiBufferOffset(start))
+                                        ..snapshot.anchor_after(MultiBufferOffset(
+                                            span.byte_range.start,
+                                        )),
+                                );
+                            }
+                        }
+                    }
+                }
+                _ => {}
+            }
+        }
+
+        if !bold_ranges.is_empty() {
+            self.highlight_text(
+                HighlightKey::FolioMarkdown(2),
+                bold_ranges,
+                HighlightStyle {
+                    font_weight: Some(FontWeight::BOLD),
+                    ..Default::default()
+                },
+                cx,
+            );
+        }
+        if !italic_ranges.is_empty() {
+            self.highlight_text(
+                HighlightKey::FolioMarkdown(3),
+                italic_ranges,
+                HighlightStyle {
+                    font_style: Some(FontStyle::Italic),
+                    ..Default::default()
+                },
+                cx,
+            );
+        }
+        strike_ranges.extend(checked_task_ranges);
+        if !strike_ranges.is_empty() {
+            self.highlight_text(
+                HighlightKey::FolioMarkdown(4),
+                strike_ranges,
+                HighlightStyle {
+                    color: Some(muted_color),
+                    strikethrough: Some(StrikethroughStyle {
+                        thickness: px(1.0),
+                        color: Some(muted_color),
+                    }),
+                    ..Default::default()
+                },
+                cx,
+            );
+        }
+        if !highlight_ranges.is_empty() {
+            let mark_bg = Hsla {
+                h: 0.13,
+                s: 0.90,
+                l: if is_dark { 0.35 } else { 0.78 },
+                a: if is_dark { 0.35 } else { 0.45 },
+            };
+            self.highlight_text(
+                HighlightKey::FolioMarkdown(5),
+                highlight_ranges,
+                HighlightStyle {
+                    background_color: Some(mark_bg),
+                    underline: Some(UnderlineStyle {
+                        thickness: px(1.0),
+                        color: Some(accent_color),
+                        wavy: false,
+                    }),
+                    ..Default::default()
+                },
+                cx,
+            );
+        }
+        if !link_label_ranges.is_empty() {
+            self.highlight_text(
+                HighlightKey::FolioMarkdown(6),
+                link_label_ranges,
+                HighlightStyle {
+                    color: Some(accent_color),
+                    underline: Some(UnderlineStyle {
+                        thickness: px(1.0),
+                        color: Some(accent_color),
+                        wavy: false,
+                    }),
+                    ..Default::default()
+                },
+                cx,
+            );
+        }
+        if !blockquote_ranges.is_empty() {
+            self.highlight_text(
+                HighlightKey::FolioMarkdown(7),
+                blockquote_ranges,
+                HighlightStyle {
+                    color: Some(muted_color),
+                    font_style: Some(FontStyle::Italic),
+                    ..Default::default()
+                },
+                cx,
+            );
+        }
+        if !list_marker_ranges.is_empty() {
+            self.highlight_text(
+                HighlightKey::FolioMarkdown(8),
+                list_marker_ranges,
+                HighlightStyle {
+                    color: Some(accent_color),
+                    font_weight: Some(FontWeight::SEMIBOLD),
+                    ..Default::default()
+                },
+                cx,
+            );
+        }
+        if !monospace_ranges.is_empty() {
+            self.highlight_text(
+                HighlightKey::FolioMarkdown(9),
+                monospace_ranges,
+                HighlightStyle {
+                    fade_out: Some(-1.0),
+                    ..Default::default()
+                },
+                cx,
+            );
+        }
+    }
+
+    fn clear_folio_markdown_wysiwyg(&mut self, cx: &mut Context<Self>) {
+        self.display_map.update(cx, |display_map, cx| {
+            display_map.remove_folds_with_type(
+                [Anchor::Min..Anchor::Max],
+                TypeId::of::<FolioMarkdownFoldTag>(),
+                cx,
+            );
+        });
+        if !self.folio_markdown_state.custom_blocks.is_empty() {
+            let prev_blocks = std::mem::take(&mut self.folio_markdown_state.custom_blocks);
+            self.remove_blocks(prev_blocks, None, cx);
+        }
+        self.clear_row_highlights::<FolioMarkdownCodeBlockRowHighlight>();
+        self.clear_highlights_with(
+            &mut |key| matches!(key, HighlightKey::FolioMarkdown(_)),
+            cx,
+        );
+        self.folio_markdown_state.last_key = None;
+    }
+}
