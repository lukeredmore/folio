+                    });
+                let cursor_color = cx.theme().players().local().cursor;
+                window.paint_quad(quad(
+                    Bounds {
+                        origin: position,
+                        size: size(px(2.0), line_height),
+                    },
+                    px(1.0),
+                    cursor_color,
+                    Edges::default(),
+                    Hsla::transparent_black(),
+                    BorderStyle::default(),
+                ));
+            }
+        }
