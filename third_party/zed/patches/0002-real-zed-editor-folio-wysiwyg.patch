+
+fn sanitize_semver_identifier(raw: &str) -> String {
+    raw.chars()
+        .filter(|ch| ch.is_ascii_alphanumeric() || *ch == '-')
+        .collect()
+}
+
+fn format_folio_semver(
+    base_version: &str,
+    build_number: Option<u64>,
+    commit_sha: Option<&str>,
+) -> String {
+    let clean_base = base_version.trim().trim_start_matches('v');
+    let parsed_base = Version::parse(clean_base)
+        .map(|v| format!("{}.{}.{}", v.major, v.minor, v.patch))
+        .unwrap_or_else(|_| "1.0.0".to_string());
+
+    let mut metadata_parts = vec!["stable".to_string()];
+    if let Some(build_number) = build_number {
+        metadata_parts.push(build_number.to_string());
+    }
+    if let Some(sha) = commit_sha {
+        let clean_sha = sanitize_semver_identifier(sha.trim());
+        if !clean_sha.is_empty() {
+            metadata_parts.push(clean_sha);
+        }
+    }
+
+    if metadata_parts.len() > 1 {
+        format!("{parsed_base}+{}", metadata_parts.join("."))
+    } else {
+        parsed_base
+    }
+}
+
+fn parse_folio_github_release(body: &[u8], default_repository: &str) -> Result<ReleaseAsset> {
+    if let Ok(direct_asset) = serde_json::from_slice::<ReleaseAsset>(body) {
+        return Ok(direct_asset);
+    }
+
+    let release: FolioGitHubRelease = serde_json::from_slice(body).with_context(|| {
+        format!(
+            "error deserializing Folio GitHub release {:?}",
+            String::from_utf8_lossy(body)
+        )
+    })?;
+
+    let fallback_url =
+        format!("https://github.com/{default_repository}/releases/latest/download/Folio-Zed.dmg");
+    let asset_url = release
+        .assets
+        .iter()
+        .find(|asset| asset.name == "Folio-Zed.dmg")
+        .or_else(|| {
+            release
+                .assets
+                .iter()
+                .find(|asset| asset.name.ends_with(".dmg") && asset.name.contains("Zed"))
+        })
+        .map(|asset| asset.browser_download_url.clone())
+        .unwrap_or(fallback_url);
+
+    let release_body = release.body.as_deref().unwrap_or("");
+    if let Some(marker_start) = release_body.find("<!-- folio-release:") {
+        let after_marker = &release_body[marker_start + "<!-- folio-release:".len()..];
+        if let Some(marker_end) = after_marker.find("-->") {
+            let json_slice = after_marker[..marker_end].trim();
+            if let Ok(manifest) = serde_json::from_str::<FolioEmbeddedManifest>(json_slice) {
+                let version = format_folio_semver(
+                    &manifest.version,
+                    manifest.build_number,
+                    manifest.commit_sha.as_deref(),
+                );
+                let url = manifest
+                    .zed_dmg_url
+                    .filter(|u| !u.trim().is_empty())
+                    .unwrap_or(asset_url);
+                return Ok(ReleaseAsset { version, url });
+            }
+        }
+    }
+
+    let title = release.name.as_deref().unwrap_or(&release.tag_name);
+    let version = title
+        .split_whitespace()
+        .find_map(|token| {
+            let candidate = token.trim_matches(|c: char| !c.is_ascii_alphanumeric() && c != '.');
+            let candidate = candidate.strip_prefix('v').unwrap_or(candidate);
+            Version::parse(candidate).ok().map(|v| v.to_string())
+        })
+        .unwrap_or_else(|| "1.0.0".to_string());
+
+    Ok(ReleaseAsset {
+        version,
+        url: asset_url,
+    })
+}
+
+fn parse_folio_build_metadata(build: &semver::BuildMetadata) -> Option<(u64, Option<&str>)> {
+    if build.is_empty() {
+        return None;
+    }
+    let mut parts = build.as_str().split('.');
+    while let Some(part) = parts.next() {
+        if let Ok(build_number) = part.parse::<u64>() {
+            let sha = parts.next().filter(|s| !s.is_empty());
+            return Some((build_number, sha));
+        }
+    }
+    None
+}
