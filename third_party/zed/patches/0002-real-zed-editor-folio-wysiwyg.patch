+fn render_table_row_element(
+    columns: &[String],
+    col_widths: &[f32],
+    is_header: bool,
+    is_separator: bool,
+    fg: Hsla,
+    header_bg: Hsla,
+    border_color: Hsla,
+) -> AnyElement {
+    let total_width: f32 = col_widths.iter().sum::<f32>().max(160.0);
+    if is_separator {
+        return div()
+            .flex()
+            .items_center()
+            .w(px(total_width))
+            .py(px(4.0))
+            .child(div().w(px(total_width)).h(px(1.5)).bg(border_color))
+            .into_any_element();
+    }
+
+    let mut row_div = div()
+        .flex()
+        .items_center()
+        .border_l_1()
+        .border_color(border_color);
+
+    if is_header {
+        row_div = row_div
+            .bg(header_bg)
+            .font_weight(FontWeight::BOLD)
+            .rounded_t(px(4.0));
+    }
+
+    for (col_idx, &width) in col_widths.iter().enumerate() {
+        let cell_text = columns.get(col_idx).cloned().unwrap_or_default();
+        row_div = row_div.child(
+            div()
+                .w(px(width))
+                .px(px(10.0))
+                .py(px(2.0))
+                .border_r_1()
+                .border_color(border_color)
+                .text_color(fg)
+                .overflow_hidden()
+                .child(SharedString::from(cell_text)),
+        );
+    }
+
+    row_div.into_any_element()
+}
