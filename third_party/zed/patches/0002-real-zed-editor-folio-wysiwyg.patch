+const FOLIO_BUILTIN_EXTENSION_ID: &str = "folio-markdown-outline";
+
+fn resolve_folio_builtin_extension_source_dir() -> Option<PathBuf> {
+    if let Some(dir) = std::env::var_os("FOLIO_BUILTIN_EXTENSION_DIR") {
+        let path = PathBuf::from(dir);
+        if path.join("extension.toml").is_file() {
+            return Some(path);
+        }
+    }
+    if let Ok(exe) = std::env::current_exe()
+        && let Some(macos_dir) = exe.parent()
+        && let Some(contents_dir) = macos_dir.parent()
+    {
+        let bundled = contents_dir
+            .join("Resources")
+            .join("builtin_extensions")
+            .join(FOLIO_BUILTIN_EXTENSION_ID);
+        if bundled.join("extension.toml").is_file() {
+            return Some(bundled);
+        }
+    }
+    let dev_fallback = Path::new(env!("CARGO_MANIFEST_DIR"))
+        .join("../../../../../zed/folio_zed_extension");
+    if dev_fallback.join("extension.toml").is_file() {
+        return Some(dev_fallback);
+    }
+    None
+}
+
+fn ensure_folio_builtin_extension_installed(
+    installed_extensions_dir: &Path,
+) -> std::io::Result<bool> {
+    let Some(src_root) = resolve_folio_builtin_extension_source_dir() else {
+        return Ok(false);
+    };
+    let ext_root = installed_extensions_dir.join(FOLIO_BUILTIN_EXTENSION_ID);
+    let lang_dir = ext_root.join("languages").join("markdown");
+    std::fs::create_dir_all(&lang_dir)?;
+
+    let relative_files = [
+        "extension.toml",
+        "languages/markdown/config.toml",
+        "languages/markdown/outline.scm",
+    ];
+
+    let mut updated = false;
+    for rel in relative_files {
+        let src_path = src_root.join(rel);
+        let Ok(expected_contents) = std::fs::read_to_string(&src_path) else {
+            continue;
+        };
+        let dst_path = ext_root.join(rel);
+        let matches_existing = std::fs::read_to_string(&dst_path)
+            .map(|existing| existing == expected_contents)
+            .unwrap_or(false);
+        if !matches_existing {
+            std::fs::write(&dst_path, expected_contents.as_bytes())?;
+            updated = true;
+        }
+    }
+    Ok(updated)
+}
