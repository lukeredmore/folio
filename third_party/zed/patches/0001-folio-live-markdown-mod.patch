 impl MarkdownPreviewElement {
-    pub fn prepaint(_view: &mut MarkdownPreviewView) {}
+    pub fn prepaint(view: &mut MarkdownPreviewView) {
+        view.canvas_display_map.clear_folds();
+        let frame = view
+            .folio_mod
+            .evaluate_buffer(&view.active_editor.buffer_text, view.selection.clone());
+        for fold in &frame.folds {
+            view.canvas_display_map.insert_fold(
+                fold.byte_range.clone(),
+                fold.placeholder_text.clone(),
+                fold.collapse_completely,
+            );
+        }
+        view.last_folio_frame = Some(frame);
+    }
 
-    pub fn paint(_view: &MarkdownPreviewView, _scene: &mut WindowScene) {}
+    pub fn paint(view: &MarkdownPreviewView, scene: &mut WindowScene) {
+        let Some(frame) = &view.last_folio_frame else {
+            return;
+        };
+        let hc = frame.theme.heading_color;
+        let math_color = Rgba {
+            r: hc.r as f32,
+            g: hc.g as f32,
+            b: hc.b as f32,
+            a: hc.a as f32,
+        };
+
+        for (_range, canvas) in &frame.display_math_canvases {
+            let bg = frame.theme.code_background;
+            scene.paint_quad(PaintQuad {
+                bounds: Bounds {
+                    origin: Point {
+                        x: Pixels(16.0),
+                        y: Pixels(8.0),
+                    },
+                    size: Size {
+                        width: Pixels(canvas.width + 24.0),
+                        height: Pixels(canvas.total_height() + 12.0),
+                    },
+                },
+                background: Rgba {
+                    r: bg.r as f32,
+                    g: bg.g as f32,
+                    b: bg.b as f32,
+                    a: (bg.a * 0.5) as f32,
+                },
+                corner_radius: 8.0,
+            });
+
+            for prim in &canvas.primitives {
+                match prim {
+                    GpuiMathPrimitive::ShapedGlyphRun {
+                        text,
+                        origin_x,
+                        baseline_y,
+                        font_size,
+                        italic,
+                        bold,
+                        ..
+                    } => {
+                        scene.paint_glyph_run(ShapedGlyphRun {
+                            text: text.clone(),
+                            origin: Point {
+                                x: Pixels(*origin_x),
+                                y: Pixels(*baseline_y),
+                            },
+                            font_size: *font_size,
+                            italic: *italic,
+                            bold: *bold,
+                            color: math_color,
+                        });
+                    }
+                    GpuiMathPrimitive::RuleQuad {
+                        x,
+                        y,
+                        width,
+                        height,
+                    } => {
+                        scene.paint_quad(PaintQuad {
+                            bounds: Bounds {
+                                origin: Point {
+                                    x: Pixels(*x),
+                                    y: Pixels(*y),
+                                },
+                                size: Size {
+                                    width: Pixels(*width),
+                                    height: Pixels(*height),
+                                },
+                            },
+                            background: math_color,
+                            corner_radius: 0.0,
+                        });
+                    }
+                    GpuiMathPrimitive::RadicalStroke {
+                        x,
+                        top_y,
+                        bottom_y,
+                        hook_width,
+                        radicand_width,
+                        ..
+                    } => {
+                        scene.paint_quad(PaintQuad {
+                            bounds: Bounds {
+                                origin: Point {
+                                    x: Pixels(*x),
+                                    y: Pixels(*top_y),
+                                },
+                                size: Size {
+                                    width: Pixels(*hook_width + *radicand_width),
+                                    height: Pixels((*bottom_y - *top_y).abs()),
+                                },
+                            },
+                            background: math_color,
+                            corner_radius: 0.0,
+                        });
+                    }
+                }
+            }
+        }
+    }
