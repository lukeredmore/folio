+    pub fn set_appearance_mode(&mut self, is_dark: bool) {
+        self.folio_mod.is_dark = is_dark;
+    }
+
+    pub fn apply_source_edit(&mut self, new_source: String, new_selection: Range<usize>) {
+        self.active_editor.buffer_text = new_source;
+        self.set_selection(new_selection);
+        MarkdownPreviewElement::prepaint(self);
+    }
+
+    pub fn set_code_fence_language(
+        &mut self,
+        fence_start_byte_offset: usize,
+        new_language: &str,
+    ) -> bool {
+        if let Some(updated) = FolioZedModSession::set_code_fence_language(
+            &self.active_editor.buffer_text,
+            fence_start_byte_offset,
+            new_language,
+        ) {
+            let sel = self.selection.clone();
+            self.apply_source_edit(updated, sel);
+            true
+        } else {
+            false
+        }
+    }
+
+    pub fn toggle_task_checkbox(&mut self, bracket_byte_offset: usize) -> bool {
+        if let Some(updated) = FolioZedModSession::toggle_task_checkbox(
+            &self.active_editor.buffer_text,
+            bracket_byte_offset,
+        ) {
+            let sel = self.selection.clone();
+            self.apply_source_edit(updated, sel);
+            true
+        } else {
+            false
+        }
+    }
+
+    pub fn insert_newline(&mut self) {
+        let pos = self.selection.end.min(self.active_editor.buffer_text.len());
+        let line_start = self.active_editor.buffer_text[..pos]
+            .rfind('\n')
+            .map(|idx| idx + 1)
+            .unwrap_or(0);
+        let line_up_to_cursor = &self.active_editor.buffer_text[line_start..pos];
+
+        match self.folio_mod.on_editor_newline(line_up_to_cursor) {
+            NewlineAction::ClearEmptyListLine => {
+                let line_end = self.active_editor.buffer_text[pos..]
+                    .find('\n')
+                    .map(|rel| pos + rel)
+                    .unwrap_or(self.active_editor.buffer_text.len());
+                let mut next = self.active_editor.buffer_text.clone();
+                next.replace_range(line_start..line_end, "");
+                self.apply_source_edit(next, line_start..line_start);
+                return;
+            }
+            NewlineAction::InsertPrefix(prefix) => {
+                let ins = format!("\n{}", prefix);
+                let mut next = self.active_editor.buffer_text.clone();
+                next.insert_str(pos, &ins);
+                let new_pos = pos + ins.len();
+                self.apply_source_edit(next, new_pos..new_pos);
+                return;
+            }
+            NewlineAction::Default => {}
+        }
+
+        let mut next = self.active_editor.buffer_text.clone();
+        next.insert(pos, '\n');
+        let new_pos = pos + 1;
+        self.apply_source_edit(next, new_pos..new_pos);
+    }
+
