 //! Zed `Editor` buffer and cursor state (`crates/editor/src/editor.rs`).
 
 use crate::display_map::DisplayMap;
+use folio_engine::markdown::NewlineAction;
+use folio_zed_mod::{FolioZedModSession, FolioZedRenderFrame};
 use std::ops::Range;
 
 pub struct Editor {
     pub buffer_text: String,
     pub selection: Range<usize>,
     pub display_map: DisplayMap,
+    pub folio_mod: FolioZedModSession,
+    pub last_folio_frame: Option<FolioZedRenderFrame>,
 }
 
 impl Editor {
     pub fn new(buffer_text: impl Into<String>) -> Self {
         Self {
             buffer_text: buffer_text.into(),
             selection: 0..0,
             display_map: DisplayMap::new(),
+            folio_mod: FolioZedModSession::new(true),
+            last_folio_frame: None,
         }
     }
 
     pub fn set_selection(&mut self, selection: Range<usize>) {
         self.selection = selection;
     }
 
+    pub fn set_appearance_mode(&mut self, is_dark: bool) {
+        self.folio_mod.is_dark = is_dark;
+    }
+
+    pub fn set_code_fence_language(
+        &mut self,
+        fence_start_byte_offset: usize,
+        new_language: &str,
+    ) -> bool {
+        if let Some(updated) = FolioZedModSession::set_code_fence_language(
+            &self.buffer_text,
+            fence_start_byte_offset,
+            new_language,
+        ) {
+            self.buffer_text = updated;
+            true
+        } else {
+            false
+        }
+    }
+
     pub fn insert_newline(&mut self) {
         let pos = self.selection.end.min(self.buffer_text.len());
+        let line_start = self.buffer_text[..pos]
+            .rfind('\n')
+            .map(|idx| idx + 1)
+            .unwrap_or(0);
+        let line_up_to_cursor = &self.buffer_text[line_start..pos];
+
+        match self.folio_mod.on_editor_newline(line_up_to_cursor) {
+            NewlineAction::ClearEmptyListLine => {
+                let line_end = self.buffer_text[pos..]
+                    .find('\n')
+                    .map(|rel| pos + rel)
+                    .unwrap_or(self.buffer_text.len());
+                self.buffer_text.replace_range(line_start..line_end, "");
+                self.selection = line_start..line_start;
+                return;
+            }
+            NewlineAction::InsertPrefix(prefix) => {
+                let ins = format!("\n{}", prefix);
+                self.buffer_text.insert_str(pos, &ins);
+                let new_pos = pos + ins.len();
+                self.selection = new_pos..new_pos;
+                return;
+            }
+            NewlineAction::Default => {}
+        }
+
         self.buffer_text.insert(pos, '\n');
         let new_pos = pos + 1;
         self.selection = new_pos..new_pos;
     }
 }
