load("@rules_cc//cc:defs.bzl", "objc_library")
load("@rules_rust//rust:defs.bzl", "rust_test")

package(default_visibility = ["//visibility:public"])

exports_files(
    glob([
        "upstream_seed/**",
        "patches/*.patch",
    ]) + [
        "build_moddable_zed.sh",
    ],
)

genrule(
    name = "moddable_zed_bundle",
    srcs = [
        "patches/0002-real-zed-editor-folio-wysiwyg.patch",
        "build_moddable_zed.sh",
    ],
    outs = ["moddable_zed_bundle.tar"],
    cmd = "PROFILE=debug; if [ \"$(COMPILATION_MODE)\" = \"opt\" ]; then PROFILE=release-fast; fi; $(location build_moddable_zed.sh) $@ $(location patches/0002-real-zed-editor-folio-wysiwyg.patch) $$PROFILE",
    tags = [
        "manual",
        "no-sandbox",
    ],
)

objc_library(
    name = "gpui_macos_platform",
    srcs = ["macos_platform/gpui_macos_window.m"],
    hdrs = ["macos_platform/gpui_macos_window.h"],
    copts = ["-Wno-deprecated-declarations"],
    sdk_frameworks = [
        "AppKit",
        "CoreGraphics",
        "CoreText",
        "Foundation",
        "QuartzCore",
    ],
)

sh_binary(
    name = "zed_with_folio_mod",
    srcs = ["run_zed_with_folio_mod.sh"],
    data = [
        "build_moddable_zed.sh",
        "patches/0002-real-zed-editor-folio-wysiwyg.patch",
        "//zed/folio_zed_extension:extension_bundle",
        "//zed/folio_zed_mod",
        "//zed/folio_zed_mod:folio_zed_mod_dylib",
    ],
)

rust_test(
    name = "zed_patched_integration_test",
    srcs = ["tests/zed_patched_integration_test.rs"],
    edition = "2021",
    deps = [
        "//core/folio_engine",
        "//zed/folio_zed_extension",
        "//zed/folio_zed_mod",
        "@zed_upstream//:editor",
        "@zed_upstream//:gpui",
        "@zed_upstream//:markdown_preview",
    ],
)

