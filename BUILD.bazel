load("@build_bazel_rules_swift//swift:swift.bzl", "swift_library", "swift_test")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("//tools:swift_format.bzl", "swift_format_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    ".bazelrc",
    "BUILD.bazel",
    "Cargo.lock",
    "MODULE.bazel",
    "MODULE.bazel.lock",
    "clippy.toml",
    "rustfmt.toml",
])

_SWIFT_LIB_COPTS = [
    "-DFOLIO_NO_MAIN",
    "-package-name",
    "Folio",
    "-swift-version",
    "6",
    "-warnings-as-errors",
]

_FOLIO_MODELS_SRCS = glob(
    ["Sources/Folio/Models/*.swift"],
    exclude = ["Sources/Folio/Models/SelectionCommentPersistence.swift"],
) + [
    "Sources/Folio/Diagnostics/EditorPerfCounters.swift",
    "Sources/Folio/Diagnostics/EditorPerfPhase.swift",
    "Sources/Folio/Diagnostics/EditorPerfRecorder.swift",
    "Sources/Folio/Editor/EditorScheduler.swift",
    "Sources/Folio/Services/FolioAppIdentity.swift",
    "Sources/Folio/Services/FolioCLIManager.swift",
    "Sources/Folio/Services/FolioCLIManager+Arguments.swift",
    "Sources/Folio/Services/FolioCLIManager+LauncherScript.swift",
    "Sources/Folio/Services/RemoteHostHistory.swift",
    "Sources/Folio/Services/RemoteWorkspaceManager+Delete.swift",
    "Sources/Folio/Services/RemoteWorkspaceManagerSync.swift",
    "Sources/Folio/Services/RemoteWorkspaceModels.swift",
    "Sources/Folio/Services/RemoteWorkspaceService.swift",
    "Sources/Folio/Services/SSHRemoteTransport.swift",
]

_FOLIO_COORDINATOR_SRCS = [
    "Sources/Folio/Diagnostics/Coordinator+PerfCounters.swift",
    "Sources/Folio/Editor/HybridMarkdownTextView+Coordinator.swift",
    "Sources/Folio/Editor/HybridMarkdownTextView+CoordinatorReflow.swift",
    "Sources/Folio/Editor/HybridMarkdownTextView+CoordinatorRestyle.swift",
    "Sources/Folio/Editor/HybridMarkdownTextView+Representable.swift",
]

_FOLIO_EDITOR_SRCS = glob(
    ["Sources/Folio/Editor/**/*.swift"],
    exclude = ["Sources/Folio/Editor/EditorScheduler.swift"] + _FOLIO_COORDINATOR_SRCS,
) + [
    "Sources/Folio/Models/SelectionCommentPersistence.swift",
]

_FOLIO_WORKSPACE_SRCS = glob(["Sources/Folio/ViewModels/*.swift"]) + _FOLIO_COORDINATOR_SRCS + [
    "Sources/Folio/Services/DocumentWindowRegistry.swift",
]

_FOLIO_UI_SRCS = glob(
    ["Sources/Folio/**/*.swift"],
    exclude = _FOLIO_MODELS_SRCS + _FOLIO_EDITOR_SRCS + _FOLIO_WORKSPACE_SRCS,
)

swift_library(
    name = "FolioModels",
    srcs = _FOLIO_MODELS_SRCS,
    copts = _SWIFT_LIB_COPTS,
    module_name = "FolioModels",
    deps = [
        "//core/folio_engine:folio_engine_ffi",
    ],
)

swift_library(
    name = "FolioEditor",
    srcs = _FOLIO_EDITOR_SRCS,
    copts = _SWIFT_LIB_COPTS,
    module_name = "FolioEditor",
    deps = [
        ":FolioModels",
        "//core/folio_engine:folio_engine_ffi",
        "@swift_math//:SwiftMath",
    ],
)

swift_library(
    name = "FolioWorkspace",
    srcs = _FOLIO_WORKSPACE_SRCS,
    copts = _SWIFT_LIB_COPTS,
    module_name = "FolioWorkspace",
    deps = [
        ":FolioEditor",
        ":FolioModels",
        "//core/folio_engine:folio_engine_ffi",
    ],
)

swift_library(
    name = "Folio",
    srcs = _FOLIO_UI_SRCS,
    copts = _SWIFT_LIB_COPTS,
    module_name = "Folio",
    deps = [
        ":FolioEditor",
        ":FolioModels",
        ":FolioWorkspace",
        "//core/folio_engine:folio_engine_ffi",
        "@swift_math//:SwiftMath",
    ],
)

_SWIFT_TEST_COPTS = _SWIFT_LIB_COPTS

_SWIFT_TEST_LINKOPTS = [
    "-Wl,-rpath,__BAZEL_XCODE_DEVELOPER_DIR__/Platforms/MacOSX.platform/Developer/usr/lib",
    "-Wl,-rpath,__BAZEL_XCODE_DEVELOPER_DIR__/Platforms/MacOSX.platform/Developer/Library/Frameworks",
    "-Wl,-rpath,__BAZEL_XCODE_DEVELOPER_DIR__/Platforms/MacOSX.platform/Developer/Library/PrivateFrameworks",
    "-Wl,-rpath,__BAZEL_XCODE_DEVELOPER_DIR__/Toolchains/XcodeDefault.xctoolchain/usr/lib/swift-6.2/macosx",
]

_SWIFT_TEST_DATA = [
    "//macos/FolioApp:folio",
    "//tst/specs:all_behavior_specs",
    "@swift_math//:math_fonts_files",
] + glob([
    "examples/**",
    "Tests/FolioTests/Fixtures/**",
])

_RESTYLE_EQUIVALENCE_TESTS = "Tests/FolioTests/IncrementalRestyleEquivalenceTests.swift"

_PERF_TESTS = [
    "Tests/FolioTests/EditorPerfInvariantTests.swift",
    "Tests/FolioTests/EditorPerfScalingTests.swift",
    "Tests/FolioTests/FolioUILagProfileTests.swift",
    "Tests/FolioTests/LaTeXPerformanceTests.swift",
    "Tests/FolioTests/LongLineLinkStylingTests.swift",
]

_EDITOR_TESTS = [
