load("@build_bazel_rules_swift//swift:swift.bzl", "swift_library", "swift_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "clippy.toml",
    "rustfmt.toml",
])

swift_library(
    name = "Folio",
    srcs = glob(["Sources/Folio/**/*.swift"]),
    copts = [
        "-DFOLIO_NO_MAIN",
        "-swift-version",
        "6",
    ],
    module_name = "Folio",
    deps = [
        "//core/folio_engine:folio_engine_ffi",
        "@swift_math//:SwiftMath",
    ],
)

swift_test(
    name = "FolioTests",
    srcs = glob(["Tests/FolioTests/**/*.swift"]),
    copts = [
        "-swift-version",
        "6",
    ],
    data = [
        "@markdown_spec//:all_spec_files",
        "@swift_math//:math_fonts_files",
        "//tst/specs:all_behavior_specs",
    ] + glob(["examples/**"]),
    deps = [
        ":Folio",
    ],
)

alias(
    name = "FolioApp",
    actual = "//macos/FolioApp:FolioApp",
)

sh_binary(
    name = "folio",
    srcs = ["//macos/FolioApp:folio"],
    data = [
        ":FolioApp",
    ],
)

alias(
    name = "folio_zed_extension",
    actual = "//zed/folio_zed_extension:extension_bundle",
)

sh_binary(
    name = "package_folio_dmg",
    srcs = ["scripts/package_dmg.sh"],
    data = [
        "build_app.sh",
        ":FolioApp",
        "//core/folio_engine:Cargo.toml",
    ],
)

sh_binary(
    name = "package_zed_extension",
    srcs = ["zed/package_extension.sh"],
    data = [
        ":folio_zed_extension",
    ],
)

