load("@build_bazel_rules_swift//swift:swift.bzl", "swift_library", "swift_test")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("//tools:swift_format.bzl", "swift_format_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    ".bazelrc",
    "BUILD.bazel",
    "Cargo.lock",
    "MODULE.bazel",
    "MODULE.bazel.lock",
    "clippy.toml",
    "rustfmt.toml",
])

swift_library(
    name = "Folio",
    srcs = glob(["Sources/Folio/**/*.swift"]),
    copts = [
        "-DFOLIO_NO_MAIN",
        "-swift-version",
        "6",
        "-warnings-as-errors",
    ],
    module_name = "Folio",
    deps = [
        "//core/folio_engine:folio_engine_ffi",
        "@swift_math//:SwiftMath",
    ],
)

_SWIFT_TEST_COPTS = [
    "-swift-version",
    "6",
    "-warnings-as-errors",
]

_SWIFT_TEST_DATA = [
    "//macos/FolioApp:folio",
    "//tst/specs:all_behavior_specs",
    "@swift_math//:math_fonts_files",
] + glob([
    "examples/**",
    "Tests/FolioTests/Fixtures/**",
])

_RESTYLE_EQUIVALENCE_TESTS = "Tests/FolioTests/IncrementalRestyleEquivalenceTests.swift"

swift_test(
    name = "FolioTests",
    srcs = glob(
        ["Tests/FolioTests/**/*.swift"],
        exclude = [_RESTYLE_EQUIVALENCE_TESTS],
    ),
    copts = _SWIFT_TEST_COPTS,
    data = _SWIFT_TEST_DATA,
    deps = [
        ":Folio",
    ],
)

# The seeded restyle property tests take most of the Swift test time. One shard per fixture keeps
# each shard well inside the test timeout; exclusive keeps them off the machine while the
# timing-sensitive perf tests in FolioTests run.
swift_test(
    name = "FolioRestyleEquivalenceTests",
    srcs = glob(["Tests/FolioTests/Support/**/*.swift"]) + [_RESTYLE_EQUIVALENCE_TESTS],
    copts = _SWIFT_TEST_COPTS,
    data = _SWIFT_TEST_DATA,
    shard_count = 4,
    tags = ["exclusive"],
    deps = [
        ":Folio",
    ],
)

# Fails when first-party Swift breaks the .swift-format layout or one of its enabled rules.
swift_format_test(
    name = "swift_format",
    srcs = glob([
        "Sources/**/*.swift",
        "Tests/**/*.swift",
    ]) + ["//macos/FolioApp:swift_srcs"],
    config = ".swift-format",
)

alias(
    name = "FolioApp",
    actual = "//macos/FolioApp:FolioApp",
)

sh_binary(
    name = "folio",
    srcs = ["//macos/FolioApp:folio"],
    data = [
        ":FolioApp",
    ],
)

alias(
    name = "folio_zed_extension",
    actual = "//zed/folio_zed_extension:archive",
)

alias(
    name = "install_zed_extension",
    actual = "//zed/folio_zed_extension:install",
    tags = ["manual"],
)

alias(
    name = "FolioDmg",
    actual = "//macos/FolioApp:FolioDmg",
    tags = ["manual"],
)
