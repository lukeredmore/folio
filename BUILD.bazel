# Shared test fixtures and assertions for editor/styler/LaTeX tests. Compiled once and cached.
swift_library(
    name = "FolioEditorTestSupport",
    testonly = True,
    srcs = glob(
        ["Tests/FolioTests/Support/**/*.swift"],
        exclude = ["Tests/FolioTests/Support/EditorHarness*.swift"],
    ),
    copts = _SWIFT_LIB_COPTS,
    module_name = "FolioEditorTestSupport",
    deps = [
        ":FolioEditor",
        ":FolioModels",
    ],
)

# Shared test fixtures for workspace view-model tests (`makeIsolatedViewModel`, `MockRemoteTransport`).
swift_library(
    name = "FolioWorkspaceTestSupport",
    testonly = True,
    srcs = ["Tests/FolioTests/FolioTestHelpers.swift"],
    copts = _SWIFT_LIB_COPTS,
    module_name = "FolioWorkspaceTestSupport",
    deps = [
        ":FolioEditor",
        ":FolioEditorTestSupport",
        ":FolioModels",
        ":FolioWorkspace",
    ],
)

# Full-window test harnesses (`EditorHarness`, `HostedMainWindow`) for UI, equivalence, and perf tests.
swift_library(
    name = "FolioTestSupport",
    testonly = True,
    srcs = ["Tests/FolioTests/WindowLayoutTestHelpers.swift"] + glob([
        "Tests/FolioTests/Support/EditorHarness*.swift",
    ]),
    copts = _SWIFT_LIB_COPTS,
    module_name = "FolioTestSupport",
    deps = [
        ":Folio",
        ":FolioEditor",
        ":FolioEditorTestSupport",
        ":FolioModels",
        ":FolioWorkspace",
        ":FolioWorkspaceTestSupport",
    ],
)

swift_test(
    name = "FolioEditorTests",
    srcs = _EDITOR_TESTS,
    copts = _SWIFT_TEST_COPTS,
    data = _SWIFT_TEST_DATA,
    linkopts = _SWIFT_TEST_LINKOPTS,
    deps = [
        ":FolioEditor",
        ":FolioEditorTestSupport",
        ":FolioModels",
    ],
)

swift_test(
    name = "FolioLaTeXTests",
    srcs = _LATEX_TESTS,
    copts = _SWIFT_TEST_COPTS,
    data = _SWIFT_TEST_DATA,
    linkopts = _SWIFT_TEST_LINKOPTS,
    deps = [
        ":FolioEditor",
        ":FolioEditorTestSupport",
        ":FolioModels",
    ],
)

swift_test(
    name = "FolioWorkspaceTests",
    srcs = _WORKSPACE_TESTS,
    copts = _SWIFT_TEST_COPTS,
    data = _SWIFT_TEST_DATA,
    linkopts = _SWIFT_TEST_LINKOPTS,
    deps = [
        ":FolioEditor",
        ":FolioEditorTestSupport",
        ":FolioModels",
        ":FolioWorkspace",
        ":FolioWorkspaceTestSupport",
    ],
)

swift_test(
    name = "FolioUITests",
    srcs = glob(
        ["Tests/FolioTests/*Tests.swift"],
        exclude = _EDITOR_TESTS + _LATEX_TESTS + _WORKSPACE_TESTS + [_RESTYLE_EQUIVALENCE_TESTS] + _PERF_TESTS,
    ),
    copts = _SWIFT_TEST_COPTS,
    data = _SWIFT_TEST_DATA,
    linkopts = _SWIFT_TEST_LINKOPTS,
    deps = [
        ":Folio",
        ":FolioEditor",
        ":FolioEditorTestSupport",
        ":FolioModels",
        ":FolioTestSupport",
        ":FolioWorkspace",
        ":FolioWorkspaceTestSupport",
    ],
)

test_suite(
    name = "FolioTests",
    tests = [
        ":FolioEditorTests",
        ":FolioLaTeXTests",
        ":FolioUITests",
        ":FolioWorkspaceTests",
    ],
)

# The seeded restyle property tests take most of the Swift test time. One shard per fixture keeps
# each shard well inside the test timeout and allows all 4 shards to run in parallel.
swift_test(
    name = "FolioRestyleEquivalenceTests",
    srcs = [_RESTYLE_EQUIVALENCE_TESTS],
    copts = _SWIFT_TEST_COPTS,
    data = _SWIFT_TEST_DATA,
    linkopts = _SWIFT_TEST_LINKOPTS,
    shard_count = 4,
    deps = [
        ":Folio",
        ":FolioEditor",
        ":FolioEditorTestSupport",
        ":FolioModels",
        ":FolioTestSupport",
        ":FolioWorkspace",
        ":FolioWorkspaceTestSupport",
    ],
)

# Timing tests compare keystrokes and passes on the same machine, so other tests running at the
# same time make them fail. Exclusive runs them alone after parallel tests complete.
swift_test(
    name = "FolioPerfTests",
    srcs = _PERF_TESTS,
    copts = _SWIFT_TEST_COPTS,
    data = _SWIFT_TEST_DATA,
    linkopts = _SWIFT_TEST_LINKOPTS,
    tags = ["exclusive"],
    deps = [
        ":Folio",
        ":FolioEditor",
        ":FolioEditorTestSupport",
        ":FolioModels",
        ":FolioTestSupport",
        ":FolioWorkspace",
        ":FolioWorkspaceTestSupport",
    ],
)

# Fails when first-party Swift breaks the .swift-format layout or one of its enabled rules.
swift_format_test(
    name = "swift_format",
    srcs = glob([
        "Sources/**/*.swift",
        "Tests/**/*.swift",
    ]) + ["//macos/FolioApp:swift_srcs"],
    config = ".swift-format",
)

alias(
    name = "FolioApp",
    actual = "//macos/FolioApp:FolioApp",
)

sh_binary(
    name = "folio",
    srcs = ["//macos/FolioApp:folio"],
    data = [
        ":FolioApp",
    ],
)

alias(
    name = "folio_zed_extension",
    actual = "//zed/folio_zed_extension:archive",
)

alias(
    name = "install_zed_extension",
    actual = "//zed/folio_zed_extension:install",
    tags = ["manual"],
)

alias(
    name = "FolioDmg",
    actual = "//macos/FolioApp:FolioDmg",
    tags = ["manual"],
)
