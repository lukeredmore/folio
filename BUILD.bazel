    "Tests/FolioTests/DiagramImageRendererTests.swift",
    "Tests/FolioTests/DrawCullingTests.swift",
    "Tests/FolioTests/ListNestedCodeAndLinkMathTests.swift",
    "Tests/FolioTests/LiveStylerAndFoldingTests.swift",
    "Tests/FolioTests/MarkdownAstAndTableTests.swift",
    "Tests/FolioTests/MathAndDiagramRenderingTests.swift",
    "Tests/FolioTests/RemoteGIFAndVideoMediaTests.swift",
    "Tests/FolioTests/RichMediaAndHtmlTests.swift",
    "Tests/FolioTests/WideTableLayoutTests.swift",
]

_LATEX_TESTS = [
    "Tests/FolioTests/LaTeXArrayAlternativesTests.swift",
    "Tests/FolioTests/LaTeXBlockStyleCacheInputTests.swift",
    "Tests/FolioTests/LaTeXDefParameterTests.swift",
    "Tests/FolioTests/LaTeXLayoutCommandTests.swift",
    "Tests/FolioTests/LaTeXMasterDetectionTests.swift",
    "Tests/FolioTests/LaTeXMasterMacroGoldenTests.swift",
    "Tests/FolioTests/LaTeXMultiLineCallTests.swift",
    "Tests/FolioTests/LaTeXProseMacroExpansionTests.swift",
    "Tests/FolioTests/LaTeXUserEnvironmentFoldingTests.swift",
    "Tests/FolioTests/SwiftMathAndMacroRenderingTests.swift",
]

_WORKSPACE_TESTS = [
    "Tests/FolioTests/AutosaveAndUndoHistoryTests.swift",
    "Tests/FolioTests/AutosaveDebounceTests.swift",
    "Tests/FolioTests/ExternalSyncAndConflictTests.swift",
    "Tests/FolioTests/ExtremeScaleSyncAndMergeTests.swift",
    "Tests/FolioTests/LaTeXDocumentStylerTests.swift",
