load("@build_bazel_rules_swift//swift:swift.bzl", "swift_library", "swift_test")

package(default_visibility = ["//visibility:public"])

swift_library(
    name = "Folio",
    srcs = glob(["Sources/Folio/**/*.swift"]),
    copts = [
        "-DFOLIO_NO_MAIN",
        "-swift-version",
        "6",
    ],
    module_name = "Folio",
    deps = [
        "//core/folio_engine:folio_engine_ffi",
    ],
)

swift_test(
    name = "FolioTests",
    srcs = glob(["Tests/FolioTests/**/*.swift"]),
    copts = [
        "-swift-version",
        "6",
    ],
    data = [
        "//third_party/markdown_spec:all_spec_files",
        "//tst/specs:all_behavior_specs",
    ],
    deps = [
        ":Folio",
    ],
)

alias(
    name = "FolioApp",
    actual = "//macos/FolioApp:FolioApp",
)

alias(
    name = "zed_with_folio_mod",
    actual = "//zed/folio_zed_mod:zed_with_folio_mod",
)

alias(
    name = "folio_zed_extension",
    actual = "//zed/folio_zed_extension:extension_bundle",
)

sh_binary(
    name = "package_folio_dmg",
    srcs = ["scripts/package_dmg.sh"],
    data = [
        "build_app.sh",
        ":FolioApp",
        "//core/folio_engine:Cargo.toml",
    ],
)

sh_binary(
    name = "package_zed_dmg",
    srcs = ["scripts/package_zed_dmg.sh"],
    data = [
        "Cargo.lock",
        "Cargo.toml",
        "build_zed_app.sh",
        ":zed_with_folio_mod",
        "//core/folio_engine:Cargo.toml",
        "//macos/FolioApp:AppIcon-Zed.icns",
    ],
)

