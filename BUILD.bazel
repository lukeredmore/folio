load("@build_bazel_rules_swift//swift:swift.bzl", "swift_library", "swift_test")

package(default_visibility = ["//visibility:public"])

swift_library(
    name = "Folio",
    srcs = glob(["Sources/Folio/**/*.swift"]),
    copts = ["-DFOLIO_NO_MAIN"],
    module_name = "Folio",
    deps = [
        "//core/folio_engine:folio_engine_ffi",
    ],
)

swift_test(
    name = "FolioTests",
    srcs = glob(["Tests/FolioTests/**/*.swift"]),
    deps = [
        ":Folio",
    ],
)

alias(
    name = "FolioApp",
    actual = "//macos/FolioApp:FolioApp",
)

alias(
    name = "zed_with_folio_mod",
    actual = "//zed/folio_zed_mod:zed_with_folio_mod",
)

alias(
    name = "folio_zed_extension",
    actual = "//zed/folio_zed_extension:extension_bundle",
)

