module(
    name = "folio",
    version = "1.0.0",
)

bazel_dep(name = "platforms", version = "0.0.11")
bazel_dep(name = "bazel_skylib", version = "1.7.1")
bazel_dep(name = "apple_support", version = "1.19.0", repo_name = "build_bazel_apple_support")
bazel_dep(name = "rules_cc", version = "0.1.1")
bazel_dep(name = "rules_swift", version = "2.4.0", repo_name = "build_bazel_rules_swift")
bazel_dep(name = "rules_apple", version = "3.17.1", repo_name = "build_bazel_rules_apple")
bazel_dep(name = "rules_rust", version = "0.64.0")
bazel_dep(name = "rules_pkg", version = "1.2.0")
bazel_dep(name = "rules_python", version = "1.0.0")
bazel_dep(name = "rules_shell", version = "0.6.1")

bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.4", dev_dependency = True)

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    extra_target_triples = ["wasm32-wasip2"],
    versions = ["1.98.1"],
)
use_repo(rust, "rust_toolchains")

register_toolchains(
    "@rust_toolchains//:all",
    # The wasm extension links no C code, so it needs only a placeholder C toolchain.
    "@rules_rust//rust/private/dummy_cc_toolchain:dummy_cc_wasm32_toolchain",
)

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = [
        "//:Cargo.toml",
        "//core/folio_engine:Cargo.toml",
        "//zed/folio_zed_extension:Cargo.toml",
    ],
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "x86_64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-gnu",
        "wasm32-wasip2",
    ],
)

# Zed extension API for the shipped wasm entrypoint. Keep `rev` in sync with
# zed/folio_zed_extension/wasm/Cargo.toml.
crate.spec(
    git = "https://github.com/lukeredmore/zed",
    package = "zed_extension_api",
    repositories = ["crates_wasm"],
    rev = "db41c83895eadc457e3ad114f16c535353172d1c",
)
crate.from_specs(
    name = "crates_wasm",
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "wasm32-wasip2",
    ],
)
use_repo(crate, "crates", "crates_wasm")

upstream = use_extension("//third_party:upstream_deps.bzl", "upstream_deps")
use_repo(upstream, "cmark_gfm", "markdown_spec", "swift_math")

# Editor indexing: sourcekit-lsp talks to Bazel through sourcekit-bazel-bsp.
# The prebuilt binary avoids the module's default SwiftPM build, which needs network access.
bazel_dep(name = "sourcekit_bazel_bsp", version = "0.8.3", dev_dependency = True)

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "sourcekit_bazel_bsp_prebuilt",
    build_file_content = 'exports_files(["sourcekit-bazel-bsp", "sourcekit-lsp"])',
    dev_dependency = True,
    sha256 = "c9329c4a95126f60fbdc576561ae66b4bc9354b3e2f059e128d1e3a386529bfc",
    url = "https://github.com/spotify/sourcekit-bazel-bsp/releases/download/0.8.3/sourcekit-bazel-bsp-0.8.3-darwin.zip",
)
